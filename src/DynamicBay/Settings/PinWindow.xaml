<Window x:Class="DynamicBay.Settings.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicBay.Core"
        Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="Transparent" FontFamily="{StaticResource Font.UI}" ShowInTaskbar="False" ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="18,44,18,16">
        <TextBlock x:Name="Heading" Style="{StaticResource ST.Base}" FontSize="18" FontWeight="Bold" />
        <TextBlock x:Name="Hint" Style="{StaticResource ST.Desc}" Margin="0,2,0,12" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Zahlencode (10 bis 16 Ziffern)', En='Code (10 to 16 digits)'}" />
        <PasswordBox x:Name="Pin" Margin="0,4,0,10" Height="32" MaxLength="16" InputScope="Number"
                     PreviewTextInput="Pin_PreviewTextInput" DataObject.Pasting="Pin_Pasting" PasswordChanged="Pin_Changed" />
        <StackPanel x:Name="RepeatPanel">
            <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Code wiederholen', En='Repeat code'}" />
            <PasswordBox x:Name="Repeat" Margin="0,4,0,10" Height="32" MaxLength="16" InputScope="Number"
                         PreviewTextInput="Pin_PreviewTextInput" DataObject.Pasting="Pin_Pasting" PasswordChanged="Pin_Changed" />
        </StackPanel>
        <TextBlock x:Name="Error" Style="{StaticResource ST.Desc}" Foreground="{DynamicResource S.Red}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Style="{StaticResource S.Button}" Content="{core:L De='Abbrechen', En='Cancel'}" IsCancel="True" />
            <Button x:Name="OkButton" Style="{StaticResource S.AccentButton}" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
