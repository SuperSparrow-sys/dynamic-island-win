<Window x:Class="DynamicBay.Settings.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicBay.Controls"
        xmlns:core="clr-namespace:DynamicBay.Core"
        Title="{core:L De='Apps auswählen', En='Choose apps'}" Width="460" Height="600" WindowStartupLocation="CenterOwner"
        Background="Transparent" FontFamily="{StaticResource Font.UI}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="18,44,18,16">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" Style="{StaticResource ST.Base}" FontSize="18" FontWeight="Bold" />
        <TextBlock DockPanel.Dock="Top" x:Name="Hint" Style="{StaticResource ST.Desc}" Margin="0,2,0,10" />
        <TextBox DockPanel.Dock="Top" x:Name="Search" Style="{StaticResource S.TextBox}" Margin="0,0,0,10" TextChanged="Search_TextChanged" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource S.Button}" Content="{core:L De='Abbrechen', En='Cancel'}" IsCancel="True" Click="Cancel_Click" />
            <Button Style="{StaticResource S.AccentButton}" Margin="8,0,0,0" x:Name="OkButton" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
        <Border Style="{StaticResource S.Card}" Margin="0">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="8,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource S.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Background="Transparent" MouseLeftButtonUp="Row_Click">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource S.Switch}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Style="{StaticResource ST.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
