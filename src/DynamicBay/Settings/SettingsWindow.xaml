<Window x:Class="DynamicBay.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicBay.Controls"
        xmlns:core="clr-namespace:DynamicBay.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DynamicBay" Width="920" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource Font.UI}" Icon="/Assets/DynamicBay.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:EqualsToBool x:Key="EqBool" />
            <c:EqualsToVis x:Key="EqVis" />
            <c:BoolToVis x:Key="Vis" />
            <c:ExcludedLabel x:Key="ExcludedLabel" />
            <c:BoolToVis x:Key="NotVis" Invert="True" />
            <c:BoolPick x:Key="MsKind" True="{core:L De='Firmen- oder Schulkonto', En='Work or school account'}" False="{core:L De='Privates Microsoft-Konto', En='Personal Microsoft account'}" />
            <Style TargetType="c:Icon">
                <Setter Property="Foreground" Value="{DynamicResource S.Text}" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar (order = SettingsPage; header items are skipped) ===== -->
        <DockPanel Margin="12,0,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="44" Margin="6,0,0,6">
                <Image Source="/Assets/DynamicBay.ico" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource ST.Base}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" Text="DynamicBay" />
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource S.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Nav_SelectionChanged">
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Settings}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Allgemein', En='General'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Palette}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Darstellung', En='Appearance'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Move}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="Position" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.EyeOff}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Verhalten', En='Behavior'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Moon}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Ruhe und Fokus', En='Quiet and focus'}" /></StackPanel>
                <ListBoxItem Style="{StaticResource S.NavHeader}" Tag="header" Content="{core:L De='INHALTE', En='CONTENT'}" />
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Modules}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Insel-Inhalte', En='Island content'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Music}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Medien', En='Media'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Headphones}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Audio und Geräte', En='Audio and devices'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Bell}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Mitteilungen', En='Notifications'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Inbox}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Ablage', En='Tray'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Calendar}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Kalender und Zeit', En='Calendar and time'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.AppWindow}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Apps und Skripte', En='Apps and scripts'}" /></StackPanel>
                <ListBoxItem Style="{StaticResource S.NavHeader}" Tag="header" Content="{core:L De='VERBINDUNGEN', En='CONNECTIONS'}" />
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.User}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Konten', En='Accounts'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Laptop}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Geräte', En='Devices'}" /></StackPanel>
                <ListBoxItem Style="{StaticResource S.NavHeader}" Tag="header" Content=" " />
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Sliders}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Erweitert', En='Advanced'}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Info}" /><TextBlock Style="{StaticResource ST.Base}" Margin="12,0,0,0" Text="{core:L De='Über', En='About'}" /></StackPanel>
            </ListBox>
        </DockPanel>

        <!-- ===== Pages ===== -->
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" Margin="0,44,0,0" VerticalScrollBarVisibility="Auto" Padding="22,4,30,30">
            <Grid MaxWidth="760" HorizontalAlignment="Stretch">

                <!-- 0 General -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=0}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Allgemein', En='General'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Mit Windows starten', En='Start with Windows'}"
                                            ToolTip="{core:L De='DynamicBay startet automatisch nach der Anmeldung.', En='DynamicBay launches automatically after you sign in.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.StartWithWindows}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Sprache', En='Language'}"
                                            ToolTip="{core:L De='Wird nach einem Neustart der App übernommen.', En='Applies after restarting the app.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="Auto" IsChecked="{Binding S.Language, Converter={StaticResource EqBool}, ConverterParameter=auto}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="Deutsch" IsChecked="{Binding S.Language, Converter={StaticResource EqBool}, ConverterParameter=de}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="English" IsChecked="{Binding S.Language, Converter={StaticResource EqBool}, ConverterParameter=en}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Tastenkürzel', En='Shortcuts'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Insel ein- und ausblenden', En='Show and hide the island'}"
                                            ToolTip="{core:L De='Feld anklicken, Kombination drücken. Geht auch über das Tray-Symbol.', En='Click the field, press the keys. Also via the tray icon.'}">
                                <TextBox x:Name="HotkeyBox" Style="{StaticResource S.TextBox}" Width="160" IsReadOnly="True" TextAlignment="Center"
                                         Text="{Binding S.ToggleHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.AudioEnabled}"
                                            Tag="{core:L De='Mikrofon stumm', En='Mute microphone'}"
                                            ToolTip="{core:L De='Feld anklicken, Kombination drücken.', En='Click the field, press the keys.'}">
                                <TextBox Style="{StaticResource S.TextBox}" Width="160" IsReadOnly="True" TextAlignment="Center"
                                         Text="{Binding S.MicMuteHotkey, Mode=OneWay}" PreviewKeyDown="MicHotkeyBox_PreviewKeyDown" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Updates" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Nach Updates suchen', En='Check for updates'}"
                                            ToolTip="{core:L De='Fragt vor der Installation.', En='Asks before installing.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CheckForUpdates}" />
                            </ContentControl>
                            <ContentControl x:Name="UpdateRow" Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Version', En='Version'}"
                                            ToolTip="{core:L De='DynamicBay startet nach dem Update von selbst neu.', En='DynamicBay restarts on its own after the update.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource ST.Desc}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="CheckUpdateButton" Style="{StaticResource S.Button}" Click="CheckUpdate_Click" Margin="0,0,8,0"
                                            Content="{core:L De='Jetzt suchen', En='Check now'}" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource S.AccentButton}" Click="InstallUpdate_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 1 Appearance -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=1}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Darstellung', En='Appearance'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Einstellungsfenster', En='Settings window'}"
                                            ToolTip="{core:L De='Hell oder dunkel. Die Insel bleibt immer schwarz.', En='Light or dark. The island always stays black.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='System', En='System'}" IsChecked="{Binding S.WindowTheme, Converter={StaticResource EqBool}, ConverterParameter=auto}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Hell', En='Light'}" IsChecked="{Binding S.WindowTheme, Converter={StaticResource EqBool}, ConverterParameter=light}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Dunkel', En='Dark'}" IsChecked="{Binding S.WindowTheme, Converter={StaticResource EqBool}, ConverterParameter=dark}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Form', En='Shape'}"
                                            ToolTip="{core:L De='Notch wächst aus dem Bildschirmrand wie beim MacBook.', En='Notch grows out of the screen edge like on a MacBook.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Insel', En='Island'}" IsChecked="{Binding S.ShapeStyle, Converter={StaticResource EqBool}, ConverterParameter=Island}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="Notch" IsChecked="{Binding S.ShapeStyle, Converter={StaticResource EqBool}, ConverterParameter=Notch}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Größe', En='Size'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="44" VerticalAlignment="Center" Text="{Binding S.Scale, StringFormat={}{0:P0}}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="0.8" Maximum="1.4" Value="{Binding S.Scale}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Ruheanzeige', En='Standby display'}"
                                            ToolTip="{core:L De='Darstellung der Insel ohne laufende Aktivität.', En='How the island looks without any activity.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Linie', En='Line'}" IsChecked="{Binding S.Idle, Converter={StaticResource EqBool}, ConverterParameter=Bar}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Uhrzeit', En='Clock'}" IsChecked="{Binding S.Idle, Converter={StaticResource EqBool}, ConverterParameter=Clock}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Minimal', En='Minimal'}" IsChecked="{Binding S.Idle, Converter={StaticResource EqBool}, ConverterParameter=Hidden}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Schatten', En='Shadow'}"
                                            ToolTip="{core:L De='Weicher Schatten unter der Insel.', En='Soft shadow under the island.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.Shadow}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Animationstempo', En='Animation speed'}"
                                            ToolTip="{core:L De='Wie schnell die Insel auf- und zuklappt.', En='How quickly the island morphs.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="44" VerticalAlignment="Center" Text="{Binding S.AnimationSpeed, StringFormat={}{0:0.0}x}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="0.6" Maximum="1.6" Value="{Binding S.AnimationSpeed}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='App-Symbole', En='App icons'}"
                                            ToolTip="{core:L De='So sehen die App-Kacheln in der Insel aus.', En='How the app tiles look in the island.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Schlicht', En='Clean'}" IsChecked="{Binding S.AppIcons, Converter={StaticResource EqBool}, ConverterParameter=Mono}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Farbig', En='Colour'}" IsChecked="{Binding S.AppIcons, Converter={StaticResource EqBool}, ConverterParameter=Color}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Dunkel', En='Dark'}" IsChecked="{Binding S.AppIcons, Converter={StaticResource EqBool}, ConverterParameter=Dark}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="Original" IsChecked="{Binding S.AppIcons, Converter={StaticResource EqBool}, ConverterParameter=Original}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Uhr', En='Clock'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Uhr-Widget', En='Clock widget'}"
                                            ToolTip="{core:L De='Auch per Klick auf die Uhr.', En='Also by clicking the clock.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Ziffern', En='Digits'}" IsChecked="{Binding S.ClockAnalog, Converter={StaticResource EqBool}, ConverterParameter=False}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Zifferblatt', En='Dial'}" IsChecked="{Binding S.ClockAnalog, Converter={StaticResource EqBool}, ConverterParameter=True}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='24-Stunden-Format', En='24-hour time'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.Clock24h}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Sekunden anzeigen', En='Show seconds'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ClockSeconds}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2 Position -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=2}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="Position" />
                    <Border Style="{StaticResource S.Card}" Padding="18">
                        <DockPanel>
                            <!-- Monitor preview with anchor points -->
                            <Grid DockPanel.Dock="Left" Width="240" Height="150">
                                <Border CornerRadius="10" BorderBrush="{DynamicResource S.FieldBorder}" BorderThickness="6" Background="{DynamicResource S.Preview}" />
                                <Border x:Name="PreviewIsland" Background="Black" CornerRadius="3" Width="44" Height="6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Top,Start" Click="Anchor_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Top,Center" Click="Anchor_Click" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Top,End" Click="Anchor_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Left,Center" Click="Anchor_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Right,Center" Click="Anchor_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Bottom,Start" Click="Anchor_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Bottom,Center" Click="Anchor_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                <Button Style="{StaticResource S.Anchor}" Tag="Bottom,End" Click="Anchor_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                            </Grid>
                            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Ankerpunkt wählen', En='Choose an anchor'}" />
                                <TextBlock Style="{StaticResource ST.Desc}" Margin="0,4,0,0"
                                           Text="{core:L De='Oder einfach mit der Maus ziehen.', En='Or simply drag it with the mouse.'}" />
                                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetPosition_Click"
                                        Content="{core:L De='Position zurücksetzen', En='Reset position'}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Bildschirme', En='Displays'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Anzeige bei mehreren Bildschirmen', En='With multiple displays'}"
                                            ToolTip="{core:L De='Eine Insel oder auf jedem Bildschirm eine.', En='One island, or one on every display.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Ein Bildschirm', En='One display'}" IsChecked="{Binding S.Displays, Converter={StaticResource EqBool}, ConverterParameter=Single}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Alle (gespiegelt)', En='All (mirrored)'}" IsChecked="{Binding S.Displays, Converter={StaticResource EqBool}, ConverterParameter=Mirror}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Position je Bildschirm-Anordnung merken', En='Remember position per display setup'}"
                                            ToolTip="{core:L De='Eigener Platz für Laptop und Büro-Monitor.', En='Own spot for laptop and office monitor.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.DockProfiles}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Ebene', En='Layer'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Wo die Insel liegt', En='Where the island lives'}"
                                            ToolTip="{core:L De='Über allem bleibt auch im Vollbild sichtbar.', En='Above all stays visible in fullscreen too.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Schwebend', En='Floating'}" IsChecked="{Binding S.Layer, Converter={StaticResource EqBool}, ConverterParameter=Floating}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Über allem', En='Above all'}" IsChecked="{Binding S.Layer, Converter={StaticResource EqBool}, ConverterParameter=AboveAll}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Nur Desktop', En='Desktop only'}" IsChecked="{Binding S.Layer, Converter={StaticResource EqBool}, ConverterParameter=Desktop}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Magnetisch einrasten', En='Magnetic snapping'}"
                                            ToolTip="{core:L De='Rastet an zwölf festen Punkten ein.', En='Snaps to twelve fixed spots.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.MagneticSnap}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Abstand zum Rand', En='Distance from edge'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="44" VerticalAlignment="Center" Text="{Binding S.Inset, StringFormat={}{0:0} px}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="0" Maximum="60" Value="{Binding S.Inset}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3 Behavior -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=3}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Verhalten', En='Behavior'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Beim Überfahren aufklappen', En='Open on hover'}"
                                            ToolTip="{core:L De='Sonst öffnet sich die Insel nur per Klick.', En='Otherwise the island opens on click only.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ExpandOnHover}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ExpandOnHover}" Tag="{core:L De='Verzögerung beim Aufklappen', En='Hover delay'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="54" VerticalAlignment="Center" Text="{Binding S.HoverDelayMs, StringFormat={}{0} ms}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="0" Maximum="800" Value="{Binding S.HoverDelayMs}" TickFrequency="20" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Verzögerung beim Zuklappen', En='Collapse delay'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="54" VerticalAlignment="Center" Text="{Binding S.CollapseDelayMs, StringFormat={}{0} ms}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="100" Maximum="2000" Value="{Binding S.CollapseDelayMs}" TickFrequency="20" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Verstecken', En='Hiding'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Aktivitäten einklappen', En='Collapse activities'}"
                                            ToolTip="{core:L De='Nach dieser Zeit schrumpft die Insel auch bei Musik oder Timer zur Linie.', En='After this time the island shrinks to a line even with music or a timer.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="40" VerticalAlignment="Center" Text="{Binding S.AutoHideSeconds, StringFormat={}{0} s}" />
                                    <Slider Style="{StaticResource S.Slider}" Width="140" Minimum="2" Maximum="30" Value="{Binding S.AutoHideSeconds}" IsEnabled="{Binding S.AutoHide}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,14,0" />
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AutoHide}" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Im Vollbild ausblenden', En='Hide in fullscreen'}"
                                            ToolTip="{core:L De='Bei Spielen, Videos und Präsentationen im Vollbild.', En='For fullscreen games, videos and presentations.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.HideInFullscreen}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Ausblenden bei diesen Apps', En='Hide while these apps are active'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding S.ExcludedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Padding="8,4" Click="RemoveExcluded_Click" Tag="{Binding}">
                                                <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" Foreground="{DynamicResource S.Text}" />
                                            </Button>
                                            <TextBlock Style="{StaticResource ST.Base}" VerticalAlignment="Center" Text="{Binding Converter={StaticResource ExcludedLabel}}" ToolTip="{Binding}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Style="{StaticResource S.AccentButton}" Margin="0,0,8,4" Click="PickExcludedApps_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" Foreground="White" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Apps auswählen', En='Choose apps'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,4" Click="PickRunningApp_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.AppWindow}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Laufende App wählen', En='Pick running app'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,4" Click="PickExcludedProgram_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.FolderOpen}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Programm wählen…', En='Choose program…'}" /></StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4 Quiet and focus -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=4}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Ruhe und Fokus', En='Quiet and focus'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Nicht stören', En='Do not disturb'}"
                                            ToolTip="{core:L De='Nur Musik und Timer, Mitteilungen still.', En='Only music and timer, notifications quiet.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.DoNotDisturb}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='In Teams- und Zoom-Calls still', En='Quiet in Teams and Zoom calls'}"
                                            ToolTip="{core:L De='Still während des Calls, mit Calldauer.', En='Quiet during the call, with call time.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.MeetingMode}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Beim Teilen des Bildschirms ausblenden', En='Hide while sharing the screen'}"
                                            ToolTip="{core:L De='Nur ein Strich, Mitteilungen ohne Text.', En='Just a line, notifications without text.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.HideWhenSharing}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Fokus-Sitzung mit Nicht stören', En='Focus session with do not disturb'}"
                                            ToolTip="{core:L De='Während einer Fokus-Sitzung still.', En='Quiet during a focus session.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.FocusQuiet}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Teams" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Teams-Status automatisch', En='Automatic Teams status'}"
                                            ToolTip="{core:L De='Nicht stören bei Fokus und Bildschirmfreigabe. Braucht Microsoft 365 unter Konten.', En='Do not disturb during focus and screen sharing. Needs Microsoft 365 under Accounts.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.TeamsAutoStatus}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5 Island content -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=5}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Insel-Inhalte', En='Island content'}" />
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="{core:L De='Aufgeklappte Insel', En='Open island'}" />
                    <TextBlock Style="{StaticResource ST.Desc}" Margin="4,-4,0,10" TextWrapping="Wrap" Text="{core:L De='Widgets zwischen Nook, System und Aus ziehen. Tippen öffnet ihre Einstellungen.', En='Drag widgets between Nook, System and Off. Tap to open their settings.'}" />
                    <Grid x:Name="WidgetBoard" Margin="0,0,0,4" />

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Kompakte Insel', En='Compact island'}" />
                    <TextBlock Style="{StaticResource ST.Desc}" Margin="4,-4,0,10" Text="{core:L De='Was nebeneinander in der Insel erscheinen darf, solange es aktiv ist.', En='What may appear side by side in the island while it is active.'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel x:Name="CompactRows" />
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Tabs" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Ablage (Dateien und Zwischenablage)', En='Tray (files and clipboard)'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ShowTrayTab}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Mitteilungen', En='Notifications'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ShowNotificationsTab}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6 Media -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=6}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Medien', En='Media'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Wiedergabe anzeigen', En='Show now playing'}"
                                            ToolTip="{core:L De='Ohne Anmeldung, für Spotify, Browser und andere Player.', En='No login needed, for Spotify, browsers and other players.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.MediaEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.MediaEnabled}" Tag="{core:L De='Bei Titelwechsel kurz anzeigen', En='Peek on track change'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.MediaPeekOnTrackChange}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.MediaEnabled}" Tag="{core:L De='Fehlende Cover laden', En='Load missing covers'}"
                                            ToolTip="{core:L De='Sucht das Cover bei Apple, wenn der Player keins mitschickt.', En='Looks the cover up at Apple when the player sends none.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.MediaCoverLookup}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Spotify" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center" Click="GoToAccount_Click" Tag="Spotify">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{core:L De='Konten', En='Accounts'}" /><c:Icon Data="{StaticResource Icon.ChevronRight}" Width="13" Height="13" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="Black" Margin="0,0,14,0" VerticalAlignment="Center">
                                <c:Icon Data="{StaticResource Glyph.Spotify}" Filled="True" Width="32" Height="32" Foreground="{DynamicResource S.Spotify}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Nicht verbunden', En='Not connected'}" Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource NotVis}}" />
                                <TextBlock Style="{StaticResource ST.Label}" Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource Vis}}">
                                    <Run Text="{core:L De='Verbunden als', En='Connected as'}" /> <Run Text="{Binding I.Spotify.UserName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Dazu: Lieblingssongs, Playlists, Warteschlange, Geräte.', En='Adds liked songs, playlists, queue, devices.'}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 7 Audio and devices -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=7}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Audio und Geräte', En='Audio and devices'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Mikrofon, Kamera und Ton anzeigen', En='Show microphone, camera and sound'}"
                                            ToolTip="{core:L De='Mikrofon, Kamera und Ton aus als kleine Symbole.', En='Microphone, camera and sound off as small symbols.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AudioEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.AudioEnabled}"
                                            Tag="{core:L De='Beim Start einer Aufnahme Stummschalten anbieten', En='Offer mute when a recording starts'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AskMuteOnMicStart}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Kopfhörer und Mikrofon', En='Headphones and microphone'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Kopfhörer sofort als Ausgabe', En='Headphones become the output'}"
                                            ToolTip="{core:L De='Verbundene Kopfhörer spielen sofort.', En='Connected headphones play at once.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AudioSwitchToHeadphones}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Guter Ton statt Headset-Mikrofon', En='Good sound instead of headset mic'}"
                                            ToolTip="{core:L De='Nimmt das PC-Mikrofon, damit AirPods gut klingen.', En='Uses the PC microphone so AirPods sound good.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AudioAvoidBluetoothMic}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Musik pausieren, wenn Kopfhörer getrennt werden', En='Pause music when headphones disconnect'}"
                                            ToolTip="{core:L De='Wie beim iPhone.', En='Like on the iPhone.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AudioPauseOnDisconnect}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Im Call', En='In a call'}"
                                            ToolTip="{core:L De='Hören über Kopfhörer, sprechen ins PC-Mikrofon.', En='Listen on headphones, speak into the PC microphone.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.AudioCallRouting}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Bluetooth und Akku', En='Bluetooth and battery'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Bluetooth-Geräte', En='Bluetooth devices'}"
                                            ToolTip="{core:L De='Verbinden, Trennen und Akkustand.', En='Connect, disconnect and battery.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.BluetoothEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Akku-Hinweise', En='Battery alerts'}"
                                            ToolTip="{core:L De='Lade-Animation und Warnung bei niedrigem Akku.', En='Charging animation and a low battery warning.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.BatteryEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.BatteryEnabled}" Tag="{core:L De='Warnen ab', En='Warn at'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="40" VerticalAlignment="Center" Text="{Binding S.BatteryLowThreshold, StringFormat={}{0} %}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="5" Maximum="40" Value="{Binding S.BatteryLowThreshold}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 8 Notifications -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=8}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Mitteilungen', En='Notifications'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Mitteilungen in der Insel', En='Notifications in the island'}"
                                            ToolTip="{Binding NotificationStatus, Mode=OneWay}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.NotificationsEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.NotificationsEnabled}" Tag="{core:L De='Nachrichtentext anzeigen', En='Show message text'}"
                                            ToolTip="{core:L De='Aus: nur App und Absender, gut für Bildschirmfreigaben.', En='Off: only app and sender, good for screen sharing.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.NotificationShowBody}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.NotificationsEnabled}" Tag="{core:L De='Anzeigedauer', En='Display time'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="40" VerticalAlignment="Center" Text="{Binding S.NotificationSeconds, StringFormat={}{0} s}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="2" Maximum="15" Value="{Binding S.NotificationSeconds}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Windows-Mitteilungen', En='Windows notifications'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource S.Switch}" IsChecked="{Binding S.SuppressBanners}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Nur in der Insel zeigen', En='Show only in the island'}" />
                                    <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Keine Windows-Banner und kein Ton, alles kommt in die Insel.', En='No Windows banners or sound, everything goes to the island.'}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding S.SuppressBanners}">
                                <TextBlock Style="{StaticResource ST.Desc}" Margin="0,0,0,8" Text="{core:L De='Ausnahmen: Diese Apps zeigen weiter ihr Windows-Banner.', En='Exceptions: these apps keep their Windows banner.'}" />
                                <StackPanel x:Name="BannerRows" />
                                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Click="AddBannerApp_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Ausnahme hinzufügen', En='Add exception'}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Stummgeschaltete Apps', En='Muted apps'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ST.Desc}" Margin="0,0,0,8" Text="{core:L De='Mitteilungen dieser Apps erscheinen nicht in der Insel.', En='Notifications from these apps don\'t appear in the island.'}" />
                            <ItemsControl ItemsSource="{Binding S.MutedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Padding="8,4" Click="RemoveMuted_Click" Tag="{Binding}">
                                                <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" Foreground="{DynamicResource S.Text}" />
                                            </Button>
                                            <TextBlock Style="{StaticResource ST.Base}" VerticalAlignment="Center" Text="{Binding}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Click="PickMuted_Click" Content="{core:L De='App aus letzten Mitteilungen wählen', En='Pick app from recent notifications'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 9 Tray (clipboard and shelf) -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=9}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Ablage', En='Tray'}" />
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="{core:L De='Zwischenablage', En='Clipboard'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Verlauf aufzeichnen', En='Record history'}"
                                            ToolTip="{core:L De='Auch Bilder und Screenshots (Win + Umschalt + S).', En='Images and screenshots too (Win + Shift + S).'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ClipboardEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClipboardEnabled}" Tag="{core:L De='Auch Texte speichern', En='Also store text'}"
                                            ToolTip="{core:L De='Inhalte aus Passwort-Managern werden ignoriert.', En='Content from password managers is ignored.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ClipboardText}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClipboardEnabled}" Tag="{core:L De='Screenshot kurz anzeigen', En='Peek on screenshot'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.PeekOnScreenshot}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClipboardEnabled}" Tag="{core:L De='Anzahl Einträge', En='Number of entries'}"
                                            ToolTip="{core:L De='Angeheftete Einträge zählen nicht mit.', En='Pinned entries don\'t count.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="40" VerticalAlignment="Center" Text="{Binding S.ClipboardMax}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="10" Maximum="200" Value="{Binding S.ClipboardMax}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClipboardEnabled}" Tag="{core:L De='Nach Neustart behalten', En='Keep after restart'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ClipboardPersist}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Screenshot-Ordner', En='Screenshot folders'}"
                                            ToolTip="{core:L De='Neue Bilder hier landen in der Insel.', En='New images here appear in the island.'}">
                                <WrapPanel x:Name="ScreenshotFolderButtons" MaxWidth="320" HorizontalAlignment="Right" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Verlauf leeren', En='Clear history'}"
                                            ToolTip="{core:L De='Angeheftete Einträge bleiben.', En='Pinned items stay.'}">
                                <Button Style="{StaticResource S.Button}" Command="{Binding I.Clipboard.ClearCommand}" Content="{core:L De='Leeren', En='Clear'}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Dateien', En='Files'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Dateiablage aktivieren', En='Enable shelf'}"
                                            ToolTip="{core:L De='Dateien auf die Insel ziehen und später wieder herausziehen.', En='Drag files onto the island and drag them out later.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ShelfEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ShelfEnabled}" Tag="{core:L De='Dateien kopieren', En='Copy files'}"
                                            ToolTip="{core:L De='Kopie statt Verweis aufs Original. Praktisch für USB-Sticks.', En='A copy instead of a link to the original. Handy for USB drives.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ShelfCopyFiles}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ShelfEnabled}" Tag="{core:L De='Nach dem Herausziehen entfernen', En='Remove after dragging out'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ShelfRemoveAfterDrag}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Ablage leeren', En='Clear shelf'}">
                                <Button Style="{StaticResource S.Button}" Command="{Binding I.Shelf.ClearCommand}" Content="{core:L De='Leeren', En='Clear'}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="Downloads"
                                            ToolTip="{core:L De='Fortschritt und fertige Datei: unter Kompakte Insel.', En='Progress and finished file: under Compact island.'}">
                                <Button Style="{StaticResource S.Button}" Click="GoToCompact_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{core:L De='Insel-Inhalte', En='Island content'}" /><c:Icon Data="{StaticResource Icon.ChevronRight}" Width="13" Height="13" Margin="6,0,0,0" /></StackPanel>
                                </Button>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Von anderen Geräten (Taildrop)', En='From other devices (Taildrop)'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Taildrop empfangen', En='Receive via Taildrop'}"
                                            ToolTip="{core:L De='Dateien per Taildrop landen sofort in der Ablage.', En='Files sent via Taildrop land in the shelf at once.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.TaildropEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.TaildropEnabled}" Tag="{core:L De='Speichern in', En='Save to'}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TaildropFolderButton" Style="{StaticResource S.PathButton}" Click="PickTaildropFolder_Click">
                                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" /><TextBlock x:Name="TaildropFolderText" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    </Button>
                                    <Button x:Name="TaildropFolderReset" Style="{StaticResource S.IconButton}" Click="ResetTaildropFolder_Click"
                                            ToolTip="{core:L De='Zurücksetzen auf Downloads', En='Reset to Downloads'}">
                                        <c:Icon Data="{StaticResource Icon.Reset}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 10 Calendar and time -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=10}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Kalender und Zeit', En='Calendar and time'}" />
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="{core:L De='Kalender', En='Calendar'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Termine anzeigen', En='Show events'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CalendarEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.CalendarEnabled}" Tag="{core:L De='Vorwarnung', En='Heads-up'}"
                                            ToolTip="{core:L De='So viele Minuten vor Beginn erscheint der Termin in der Insel.', En='Minutes before start when the event appears in the island.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="50" VerticalAlignment="Center" Text="{Binding S.CalendarPeekMinutes, StringFormat={}{0} min}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="1" Maximum="30" Value="{Binding S.CalendarPeekMinutes}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <Border BorderBrush="{DynamicResource S.Divider}" BorderThickness="0,1,0,0" Padding="16,12" MinHeight="62">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center" Margin="16,0,0,0" Click="GoToAccount_Click" Tag="Calendars">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{core:L De='Konten', En='Accounts'}" /><c:Icon Data="{StaticResource Icon.ChevronRight}" Width="13" Height="13" Margin="6,0,0,0" /></StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Verbundene Kalender', En='Connected calendars'}" />
                                        <TextBlock x:Name="CalendarSummary" Style="{StaticResource ST.Desc}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Timer" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Timer', En='Timer'}"
                                            ToolTip="{core:L De='Timer und Fokuszeiten mit Pausen in der Insel.', En='Timers and focus sessions with breaks in the island.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.TimerEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.TimerEnabled}" Tag="{core:L De='Fokuszeit', En='Focus time'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="50" VerticalAlignment="Center" Text="{Binding S.PomodoroWorkMinutes, StringFormat={}{0} min}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="5" Maximum="90" Value="{Binding S.PomodoroWorkMinutes}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.TimerEnabled}" Tag="{core:L De='Pause', En='Break'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ST.Desc}" Width="50" VerticalAlignment="Center" Text="{Binding S.PomodoroBreakMinutes, StringFormat={}{0} min}" />
                                    <Slider Style="{StaticResource S.Slider}" Minimum="1" Maximum="30" Value="{Binding S.PomodoroBreakMinutes}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Zeiterfassung', En='Time tracking'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Datei', En='File'}"
                                            ToolTip="{core:L De='Eine CSV-Datei für alle Projekte, in Viertelstunden.', En='One CSV file for all projects, in quarter hours.'}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TimeFileButton" Style="{StaticResource S.PathButton}" Click="PickTimeFile_Click">
                                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.FileText}" Width="14" Height="14" /><TextBlock x:Name="TimeFileText" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource S.IconButton}" Command="{Binding I.Time.ShowFileCommand}" ToolTip="{core:L De='Im Explorer zeigen', En='Show in Explorer'}">
                                        <c:Icon Data="{StaticResource Icon.FolderOpen}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Erinnern und nachfragen', En='Remind and ask'}"
                                            ToolTip="{core:L De='Fragt nach 4 Stunden, abends und nach Pausen.', En='Asks after 4 hours, in the evening and after breaks.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.TimeReminders}" />
                            </ContentControl>
                            <Border BorderBrush="{DynamicResource S.Divider}" BorderThickness="0,1,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ST.Label}" Margin="0,0,0,8" Text="{core:L De='Projekte', En='Projects'}" />
                                    <StackPanel x:Name="ProjectRows" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="AddProject_Click">
                                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Hinzufügen', En='Add'}" /></StackPanel>
                                        </Button>
                                        <TextBox x:Name="NewProject" Style="{StaticResource S.TextBox}" KeyDown="NewProject_KeyDown" />
                                    </DockPanel>
                                    <Button Style="{StaticResource S.AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding I.OpenTimeTrackingCommand}"
                                            Content="{core:L De='Zeiterfassung öffnen (Einträge, nachtragen)', En='Open time tracking (entries, add time)'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Aufgaben', En='Tasks'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Liste im Widget Aufgaben', En='List in the tasks widget'}" />
                            <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Welche To-Do-Liste die Insel zeigt.', En='Which To Do list the island shows.'}" />
                            <WrapPanel x:Name="TodoListChoices" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 11 Apps and scripts -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=11}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Apps und Skripte', En='Apps and scripts'}" />
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="{core:L De='Schnellstart-Apps', En='Launcher apps'}" />
                    <TextBlock Style="{StaticResource ST.Desc}" Margin="4,-4,0,10" Text="{core:L De='Diese Apps erscheinen im Schnellstart. Store-Apps wie WhatsApp gehen auch.', En='These apps appear in the launcher. Store apps like WhatsApp work too.'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding I.Shortcuts.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Padding="8,6" VerticalAlignment="Center" Click="RemoveShortcut_Click" Tag="{Binding}">
                                                <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" Foreground="{DynamicResource S.Text}" />
                                            </Button>
                                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource AppTile}" Margin="0,0,12,0" />
                                            <TextBlock Style="{StaticResource ST.Base}" VerticalAlignment="Center" Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource S.AccentButton}" Click="PickInstalledApps_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" Foreground="White" /><TextBlock Margin="6,0,0,0" Text="{core:L De='App hinzufügen', En='Add app'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="PickFromFolder_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.FolderOpen}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Aus Ordner wählen', En='Pick from folder'}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Eigene Widgets (Skripte)', En='Own widgets (scripts)'}" />
                    <TextBlock Style="{StaticResource ST.Desc}" Margin="4,-4,0,10" TextWrapping="Wrap"
                               Text="{core:L De='Eigene Widgets in JavaScript, wie Scriptable. Ohne Zugriff auf deine Dateien.', En='Own widgets in JavaScript, like Scriptable. No access to your files.'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <StackPanel x:Name="ScriptRows" />
                            <WrapPanel Margin="16,12,16,12">
                                <Button Style="{StaticResource S.AccentButton}" Margin="0,0,8,4" Click="NewScript_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" Foreground="White" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Neues Skript', En='New script'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,4" Click="ImportScript_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Code}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Skript hinzufügen…', En='Add script…'}" /></StackPanel>
                                </Button>
                                <Button x:Name="ScriptFolderButton" Style="{StaticResource S.PathButton}" Margin="0,0,8,4" Click="OpenScriptFolder_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" /><TextBlock x:Name="ScriptFolderText" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Link}" Margin="4,0,0,4" VerticalAlignment="Center" Click="ScriptHelp_Click" Content="{core:L De='Anleitung', En='Guide'}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ST.Group}" Text="Claude" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Claude Code anzeigen', En='Show Claude Code'}"
                                            ToolTip="{core:L De='Deine Claude-Code-Sitzungen und ihr Status.', En='Your Claude Code sessions and their status.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.ClaudeEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClaudeEnabled}" Tag="{core:L De='Sofort Bescheid geben', En='Instant updates'}"
                                            ToolTip="{core:L De='Claude meldet sich sofort statt alle paar Sekunden. settings.json wird gesichert.', En='Claude reports at once instead of every few seconds. settings.json is backed up.'}">
                                <Grid>
                                    <Button Style="{StaticResource S.AccentButton}" Command="{Binding I.Claude.InstallHooksCommand}" Content="{core:L De='Einrichten', En='Set up'}"
                                            Visibility="{Binding I.Claude.HooksInstalled, Converter={StaticResource NotVis}}" />
                                    <Button Style="{StaticResource S.Button}" Command="{Binding I.Claude.RemoveHooksCommand}" Content="{core:L De='Entfernen', En='Remove'}"
                                            Visibility="{Binding I.Claude.HooksInstalled, Converter={StaticResource Vis}}" />
                                </Grid>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.ClaudeEnabled}" Tag="{core:L De='Sitzungen anderer PCs', En='Sessions on other PCs'}"
                                            ToolTip="{core:L De='Über einen Cloud-Ordner, den alle PCs sehen.', En='Through a cloud folder all PCs can see.'}">
                                <Button x:Name="ClaudeShareButton" Style="{StaticResource S.PathButton}" Click="PickClaudeShare_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource Icon.Cloud}" Width="14" Height="14" />
                                        <TextBlock x:Name="ClaudeShareText" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                        <c:Icon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 12 Accounts -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=12}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Konten', En='Accounts'}" />

                    <!-- Microsoft 365 -->
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="Microsoft 365" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.AccentButton}" VerticalAlignment="Center" Click="MicrosoftConnect_Click"
                                        Content="{core:L De='Verbinden', En='Connect'}" Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource NotVis}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.Link}" VerticalAlignment="Center" Margin="0,0,16,0" Click="ToggleSetup_Click" Tag="MsSetup"
                                        Content="{core:L De='Einrichtung', En='Setup'}" Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource NotVis}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center" Click="MicrosoftSignOut_Click"
                                        Content="{core:L De='Trennen', En='Disconnect'}" Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource Vis}}" />
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource S.Field}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <c:Icon Data="{StaticResource Icon.Mail}" Width="16" Height="16" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Nicht verbunden', En='Not connected'}" Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource NotVis}}" />
                                    <TextBlock Style="{StaticResource ST.Label}" Text="{Binding S.MicrosoftUser}" TextTrimming="CharacterEllipsis" Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource Vis}}" />
                                    <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Outlook-Kalender, Teams-Status, To Do und Kontakte.', En='Outlook calendar, Teams status, To Do and contacts.'}"
                                               Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource NotVis}}" />
                                    <TextBlock Style="{StaticResource ST.Desc}" Text="{Binding I.Microsoft.IsWorkAccount, Converter={StaticResource MsKind}}"
                                               Visibility="{Binding I.Microsoft.IsConnected, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- setup: opens with "Connect" -->
                            <StackPanel x:Name="MsSetup" Visibility="Collapsed">
                                <Border Height="1" Background="{DynamicResource S.Divider}" Margin="0,12" />
                                <TextBlock Style="{StaticResource ST.Desc}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{core:L De='Einmal eine App-Kennung anlegen, die Anleitung zeigt wie.', En='Create an app ID once, the guide shows how.'}" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Style="{StaticResource S.Button}" Margin="0,0,8,0" Click="OpenMicrosoftGuide_Click" Content="{core:L De='Anleitung', En='Guide'}" />
                                    <Button Style="{StaticResource S.Button}" Click="OpenEntra_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{core:L De='App-Registrierung öffnen', En='Open app registrations'}" /><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="8,0,0,0" /></StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Anwendungs-ID (Client-ID)', En='Application (client) ID'}" />
                                <TextBox Style="{StaticResource S.TextBox}" Margin="0,2,0,8" Text="{Binding S.MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource ST.Desc}" TextWrapping="Wrap"
                                           Text="{core:L De='Verzeichnis: common lassen. Nur für eine Firmen-App die Verzeichnis-ID eintragen.', En='Directory: keep common. Only for a company-only app enter the directory ID.'}" />
                                <TextBox Style="{StaticResource S.TextBox}" Margin="0,2,0,10" Text="{Binding S.MicrosoftTenant, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource S.AccentButton}" HorizontalAlignment="Left" Click="MicrosoftSignIn_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.LogIn}" Width="13" Height="13" Foreground="White" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Mit Microsoft anmelden', En='Sign in with Microsoft'}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- connected, work account: Teams presence needs one more consent -->
                            <DockPanel Margin="0,12,0,0">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding I.Microsoft.IsConnected}" Value="True" />
                                                    <Condition Binding="{Binding I.Microsoft.IsWorkAccount}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Click="MicrosoftPresence_Click" VerticalAlignment="Center"
                                        Visibility="{Binding S.MicrosoftPresence, Converter={StaticResource NotVis}}" Content="{core:L De='Freischalten', En='Allow'}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Teams-Status', En='Teams status'}" />
                                    <TextBlock Style="{StaticResource ST.Desc}" TextWrapping="Wrap" Text="{core:L De='Microsoft fragt einmal nach der Erlaubnis.', En='Microsoft asks for permission once.'}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource ST.Desc}" Foreground="{DynamicResource S.Orange}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{Binding I.Microsoft.Status}" Visibility="{Binding I.Microsoft.Status, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Spotify -->
                    <TextBlock Style="{StaticResource ST.Group}" Text="Spotify" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.AccentButton}" VerticalAlignment="Center" Click="SpotifyConnect_Click"
                                        Content="{core:L De='Verbinden', En='Connect'}"
                                        Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource NotVis}}" IsEnabled="{Binding I.Spotify.IsBusy, Converter={StaticResource S.InvBool}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.Link}" VerticalAlignment="Center" Margin="0,0,16,0" Click="ToggleSetup_Click" Tag="SpotifySetup"
                                        Content="{core:L De='Einrichtung', En='Setup'}" Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource NotVis}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center"
                                        Command="{Binding I.Spotify.DisconnectCommand}" Content="{core:L De='Trennen', En='Disconnect'}"
                                        Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource Vis}}" />
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="Black" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <c:Icon Data="{StaticResource Glyph.Spotify}" Filled="True" Width="32" Height="32" Foreground="{DynamicResource S.Spotify}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Nicht verbunden', En='Not connected'}" Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource NotVis}}" />
                                    <TextBlock Style="{StaticResource ST.Label}" Visibility="{Binding I.Spotify.IsConnected, Converter={StaticResource Vis}}">
                                        <Run Text="{core:L De='Verbunden als', En='Connected as'}" /> <Run Text="{Binding I.Spotify.UserName, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Playlists, Warteschlange, Geräte. Braucht Premium.', En='Playlists, queue, devices. Needs Premium.'}" />
                                    <TextBlock Style="{StaticResource ST.Desc}" Foreground="{DynamicResource S.Orange}" Text="{Binding I.Spotify.Status}"
                                               Visibility="{Binding I.Spotify.Status, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- setup: opens with "Connect" while there is no Client ID -->
                            <StackPanel x:Name="SpotifySetup" Visibility="Collapsed">
                                <Border Height="1" Background="{DynamicResource S.Divider}" Margin="0,12" />
                                <TextBlock Style="{StaticResource ST.Base}" FontSize="12.5" Margin="0,0,0,6"><Run FontWeight="SemiBold">1.</Run> <Run Text="{core:L De='Öffne das Spotify Developer Dashboard und melde dich an.', En='Open the Spotify Developer Dashboard and sign in.'}" /></TextBlock>
                                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="18,0,0,10" Click="OpenSpotifyDashboard_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="developer.spotify.com/dashboard" /><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="8,0,0,0" /></StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource ST.Base}" FontSize="12.5" Margin="0,0,0,6"><Run FontWeight="SemiBold">2.</Run> <Run Text="{core:L De='Create app, Name beliebig, Web API wählen. Diese Redirect URI eintragen:', En='Create app, any name, select Web API. Enter this Redirect URI:'}" /></TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="18,0,0,10">
                                    <Button Style="{StaticResource S.Button}" Click="CopyRedirect_Click">
                                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Copy}" Width="13" Height="13" /><TextBlock x:Name="CopyRedirectText" Margin="6,0,0,0" Text="{core:L De='Kopieren', En='Copy'}" /></StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource ST.Desc}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding RedirectUri, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ST.Base}" FontSize="12.5" Margin="0,0,0,6"><Run FontWeight="SemiBold">3.</Run> <Run Text="{core:L De='Die Client ID aus den App-Einstellungen hier einfügen:', En='Paste the Client ID from the app settings here:'}" /></TextBlock>
                                <TextBox Style="{StaticResource S.TextBox}" Margin="18,0,0,10" Text="{Binding S.SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource ST.Base}" FontSize="12.5"><Run FontWeight="SemiBold">4.</Run> <Run Text="{core:L De='Oben auf Verbinden klicken und im Browser bestätigen.', En='Click Connect above and confirm in the browser.'}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calendars -->
                    <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Kalender', En='Calendars'}" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12">
                        <StackPanel>
                            <StackPanel x:Name="CalendarRows" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,6" Click="AddICloud_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Cloud}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='iCloud / GMX verbinden', En='Connect iCloud / GMX'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,6" Click="AddGoogle_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.User}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='Google verbinden', En='Connect Google'}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource S.Button}" Margin="0,0,8,6" Click="AddIcs_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Link}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="{core:L De='ICS-Link (Outlook u. a.)', En='ICS link (Outlook etc.)'}" /></StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- CalDAV form (iCloud, GMX, web.de, other) -->
                            <StackPanel x:Name="ICloudForm" Visibility="Collapsed" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource S.Divider}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource ST.Label}" Margin="0,0,0,8" Text="{core:L De='iCloud- oder CalDAV-Kalender', En='iCloud or CalDAV calendar'}" />
                                <Border Style="{StaticResource S.Segments}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" GroupName="caldav" Content="iCloud" Tag="https://caldav.icloud.com/" IsChecked="True" Checked="CalDavProvider_Checked" />
                                        <RadioButton Style="{StaticResource S.Segment}" GroupName="caldav" Content="GMX" Tag="https://caldav.gmx.net/" Checked="CalDavProvider_Checked" />
                                        <RadioButton Style="{StaticResource S.Segment}" GroupName="caldav" Content="web.de" Tag="https://caldav.web.de/" Checked="CalDavProvider_Checked" />
                                        <RadioButton Style="{StaticResource S.Segment}" GroupName="caldav" Content="{core:L De='Andere', En='Other'}" Tag="" Checked="CalDavProvider_Checked" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="CalDavAppleHint">
                                    <TextBlock Style="{StaticResource ST.Desc}" Margin="0,0,0,4" Text="{core:L De='Ein app-spezifisches Passwort, nicht dein Apple-ID-Passwort.', En='An app-specific password, not your Apple ID password.'}" />
                                    <Button Style="{StaticResource S.Link}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="OpenAppleId_Click" Content="appleid.apple.com" />
                                </StackPanel>
                                <StackPanel x:Name="CalDavServerPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Server-Adresse (https)', En='Server address (https)'}" />
                                    <TextBox x:Name="ICloudServer" Style="{StaticResource S.TextBox}" Margin="0,2,0,8" Text="https://caldav.icloud.com/" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Apple-ID bzw. E-Mail-Adresse', En='Apple ID or email address'}" />
                                <TextBox x:Name="ICloudUser" Style="{StaticResource S.TextBox}" Margin="0,2,0,8" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Passwort', En='Password'}" />
                                <PasswordBox x:Name="ICloudPassword" Margin="0,2,0,10" Height="32" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource S.AccentButton}" Click="SaveICloud_Click" Content="{core:L De='Verbinden und testen', En='Connect and test'}" />
                                    <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="CloseCalForms_Click" Content="{core:L De='Abbrechen', En='Cancel'}" />
                                </StackPanel>
                                <TextBlock x:Name="ICloudStatus" Style="{StaticResource ST.Desc}" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Google form -->
                            <StackPanel x:Name="GoogleForm" Visibility="Collapsed" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource S.Divider}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource ST.Label}" Text="Google Kalender" />
                                <TextBlock Style="{StaticResource ST.Desc}" Margin="0,2,0,8" Text="{core:L De='Einmalig: In der Google Cloud Console ein Projekt anlegen, die Google Calendar API aktivieren, den OAuth-Zustimmungsbildschirm einrichten (extern, dich selbst als Testnutzer) und unter Anmeldedaten eine OAuth-Client-ID vom Typ Desktop-App erstellen. Client-ID und Clientschlüssel hier eintragen.', En='Once: in the Google Cloud Console create a project, enable the Google Calendar API, set up the OAuth consent screen (external, yourself as test user) and create an OAuth client ID of type Desktop app under Credentials. Enter client ID and secret here.'}" />
                                <Button Style="{StaticResource S.Link}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="OpenGoogleConsole_Click" Content="console.cloud.google.com" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="Client-ID" />
                                <TextBox x:Name="GoogleClientId" Style="{StaticResource S.TextBox}" Margin="0,2,0,8" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Clientschlüssel', En='Client secret'}" />
                                <PasswordBox x:Name="GoogleSecret" Margin="0,2,0,10" Height="32" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource S.AccentButton}" Click="SaveGoogle_Click" Content="{core:L De='Mit Google anmelden', En='Sign in with Google'}" />
                                    <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="CloseCalForms_Click" Content="{core:L De='Abbrechen', En='Cancel'}" />
                                </StackPanel>
                                <TextBlock x:Name="GoogleStatus" Style="{StaticResource ST.Desc}" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- ICS form -->
                            <StackPanel x:Name="IcsForm" Visibility="Collapsed" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource S.Divider}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Kalender-Link (ICS)', En='Calendar link (ICS)'}" />
                                <TextBlock Style="{StaticResource ST.Desc}" Margin="0,2,0,8" Text="{core:L De='Outlook: Einstellungen, Kalender, Freigegebene Kalender, Kalender veröffentlichen, ICS-Link kopieren. Google ohne Anmeldung: Kalendereinstellungen, Privatadresse im iCal-Format. iCloud ohne Anmeldung: Kalender teilen, Öffentlicher Kalender.', En='Outlook: Settings, Calendar, Shared calendars, Publish a calendar, copy the ICS link. Google without login: calendar settings, Secret address in iCal format. iCloud without login: share calendar, Public calendar.'}" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="Name" />
                                <TextBox x:Name="IcsName" Style="{StaticResource S.TextBox}" Margin="0,2,0,8" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="Link" />
                                <TextBox x:Name="IcsUrl" Style="{StaticResource S.TextBox}" Margin="0,2,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource S.AccentButton}" Click="SaveIcs_Click" Content="{core:L De='Hinzufügen und testen', En='Add and test'}" />
                                    <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="CloseCalForms_Click" Content="{core:L De='Abbrechen', En='Cancel'}" />
                                </StackPanel>
                                <TextBlock x:Name="IcsStatus" Style="{StaticResource ST.Desc}" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 13 Devices: pairing with the user's other PC, CursorHop -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=13}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Geräte', En='Devices'}" />

                    <!-- This device: the link on or off, and the name the other device sees -->
                    <TextBlock Style="{StaticResource ST.Group}" Margin="4,0,0,8" Text="{core:L De='Dieses Gerät', En='This device'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Geräte koppeln', En='Pair devices'}"
                                            ToolTip="{core:L De='Verbindet DynamicBay auf PC und Laptop, im selben Netz oder über Tailscale.', En='Connects DynamicBay on PC and laptop, on the same network or via Tailscale.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.LinkEnabled}" Tag="{core:L De='Gerätename', En='Device name'}"
                                            ToolTip="{core:L De='So sieht das andere Gerät diesen PC.', En='How the other device sees this PC.'}">
                                <Grid Width="200">
                                    <TextBox Style="{StaticResource S.TextBox}" Height="30" MaxLength="64" Text="{Binding S.LinkDeviceName, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock x:Name="DeviceNamePlaceholder" Style="{StaticResource ST.Desc}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding S.LinkDeviceName, Converter={StaticResource NotVis}}" />
                                </Grid>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource ST.Desc}" Margin="6,2,0,0" Visibility="{Binding S.LinkEnabled, Converter={StaticResource NotVis}}"
                               Text="{core:L De='Aus: dieser PC ist für andere Geräte unsichtbar und teilt nichts.', En='Off: this PC is invisible to other devices and shares nothing.'}" />

                    <StackPanel Visibility="{Binding S.LinkEnabled, Converter={StaticResource Vis}}">
                        <!-- Paired devices -->
                        <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Gekoppelte Geräte', En='Paired devices'}" />
                        <Border Style="{StaticResource S.Card}" Padding="16,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ST.Desc}" Margin="0,8,0,8" Visibility="{Binding I.Link.HasDevices, Converter={StaticResource NotVis}}"
                                           Text="{core:L De='Noch kein Gerät gekoppelt.', En='No device paired yet.'}" />
                                <ItemsControl ItemsSource="{Binding I.Link.Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center" Padding="12,5"
                                                            Command="{Binding DataContext.I.Link.AskUnpairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding ConfirmUnpair, Converter={StaticResource NotVis}}" Content="{core:L De='Entkoppeln', En='Unpair'}" />
                                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource S.Text3}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ST.Label}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource ST.Desc}" Text="{Binding StateText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <!-- Asked in place, no message box -->
                                                <DockPanel Margin="20,8,0,2" Visibility="{Binding ConfirmUnpair, Converter={StaticResource Vis}}">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource S.Button}" Padding="12,5" Content="{core:L De='Abbrechen', En='Cancel'}"
                                                                Command="{Binding DataContext.I.Link.CancelUnpairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource S.Button}" Padding="12,5" Margin="8,0,0,0" Foreground="{DynamicResource S.Red}" Content="{core:L De='Entkoppeln', En='Unpair'}"
                                                                Command="{Binding DataContext.I.Link.UnpairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource ST.Desc}" VerticalAlignment="Center"
                                                               Text="{core:L De='Danach muss neu gekoppelt werden.', En='You will have to pair again.'}" />
                                                </DockPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource S.Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource S.Red}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Add a device -->
                        <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Gerät hinzufügen', En='Add a device'}" />
                        <Border Style="{StaticResource S.Card}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Koppeln erlauben', En='Allow pairing'}"
                                                ToolTip="{core:L De='Zwei Minuten lang darf ein anderes Gerät dieses hier koppeln.', En='For two minutes another device may pair with this one.'}">
                                    <Grid>
                                        <Button Style="{StaticResource S.AccentButton}" Command="{Binding I.Link.AllowPairingCommand}" Content="{core:L De='Koppeln erlauben', En='Allow pairing'}"
                                                Visibility="{Binding I.Link.PairingOpen, Converter={StaticResource NotVis}}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding I.Link.PairingOpen, Converter={StaticResource Vis}}">
                                            <TextBlock Style="{StaticResource ST.Desc}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Run Text="{core:L De='Offen noch', En='Open for'}" /> <Run Text="{Binding I.Link.PairingRemaining, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Style="{StaticResource S.Button}" Command="{Binding I.Link.ClosePairingCommand}" Content="{core:L De='Beenden', En='Stop'}" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                                <!-- Found nearby or over Tailscale -->
                                <Border BorderBrush="{DynamicResource S.Divider}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource S.IconButton}" Command="{Binding I.Link.RefreshCommand}"
                                                    ToolTip="{core:L De='Neu suchen', En='Search again'}">
                                                <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Gefundene Geräte', En='Devices found'}" />
                                                <TextBlock Style="{StaticResource ST.Desc}" Visibility="{Binding I.Link.HasFound, Converter={StaticResource NotVis}}"
                                                           Text="{core:L De='Im selben Netz und über Tailscale wird gesucht.', En='Searching the network and Tailscale.'}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding I.Link.Found}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Padding="12,5" Content="{core:L De='Koppeln', En='Pair'}"
                                                                IsEnabled="{Binding DataContext.I.Link.Busy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource S.InvBool}}"
                                                                Command="{Binding DataContext.I.Link.PairFoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Laptop}" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource S.Text2}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource ST.Base}" Text="{Binding Name}" />
                                                            <TextBlock Style="{StaticResource ST.Desc}">
                                                                <Run Text="{Binding ViaText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Adresse', En='Address'}"
                                                ToolTip="{core:L De='IP, Rechnername oder Tailscale-Name, optional mit :Port.', En='IP, computer name or Tailscale name, optionally with :port.'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="PairAddress" Style="{StaticResource S.TextBox}" Width="180" Height="30" KeyDown="PairAddress_KeyDown" />
                                        <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="PairAddress_Click" Content="{core:L De='Koppeln', En='Pair'}"
                                                IsEnabled="{Binding I.Link.Busy, Converter={StaticResource S.InvBool}}" />
                                    </StackPanel>
                                </ContentControl>
                                <TextBlock x:Name="PairStatusText" Style="{StaticResource ST.Desc}" Margin="16,0,16,12" TextWrapping="Wrap" Text="{Binding I.Link.PairStatus}"
                                           Visibility="{Binding I.Link.PairStatus, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Border>

                        <!-- What is shared -->
                        <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Teilen mit gekoppelten Geräten', En='Share with paired devices'}" />
                        <Border Style="{StaticResource S.Card}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Dateien', En='Files'}"
                                                ToolTip="{core:L De='Senden aus der Ablage, Empfangenes landet in Downloads\\DynamicBay und in der Ablage.', En='Send from the shelf, received files go to Downloads\\DynamicBay and the shelf.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareFiles}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Zwischenablage', En='Clipboard'}"
                                                ToolTip="{core:L De='Kopierte Texte und Bilder erscheinen im Verlauf des anderen Geräts, Passwörter nie.', En='Copied text and images appear in the other device\'s history, passwords never.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareClipboard}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Mitteilungen', En='Notifications'}"
                                                ToolTip="{core:L De='Mitteilungen dieses PCs erscheinen auch auf dem anderen Gerät.', En='This PC\'s notifications also show on the other device.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareNotifications}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Musik', En='Music'}"
                                                ToolTip="{core:L De='Zeigt und steuert die Wiedergabe des anderen Geräts, wenn hier nichts läuft.', En='Shows and controls the other device\'s playback when nothing plays here.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareMedia}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Ton', En='Sound'}"
                                                ToolTip="{core:L De='Der Ton eines Geräts kann im Audio-Widget auf das andere wechseln.', En='The sound of one device can move to the other in the Audio widget.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareAudio}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Status', En='Status'}"
                                                ToolTip="{core:L De='Name, Akku und Version für die Karte „Gekoppelte Geräte“.', En='Name, battery and version for the “Paired devices” card.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareStatus}" />
                                </ContentControl>
                            </StackPanel>
                        </Border>
                        <!-- Working together: the second card of the same group -->
                        <TextBlock Style="{StaticResource ST.Desc}" Margin="6,10,0,6" Text="{core:L De='Zusammen arbeiten', En='Working together'}" />
                        <Border Style="{StaticResource S.Card}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Timer', En='Timer'}"
                                                ToolTip="{core:L De='Timer und Pomodoro laufen auf beiden Geräten, das Ende kommt einmal.', En='Timers and Pomodoro run on both devices, the end shows once.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareTimer}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Ruhe und Fokus', En='Quiet and focus'}"
                                                ToolTip="{core:L De='„Nicht stören“, Anrufe und Fokus gelten für beide Geräte.', En='“Do not disturb”, calls and focus apply to both devices.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareQuiet}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Fragen', En='Questions'}"
                                                ToolTip="{core:L De='Fragen mit Knöpfen beantwortest du auf dem Hauptgerät.', En='Questions with buttons are answered on the main device.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareQuestions}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Akku', En='Battery'}"
                                                ToolTip="{core:L De='Akku-Hinweise des Laptops erscheinen auf dem Hauptgerät.', En='Laptop battery alerts show on the main device.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkShareBattery}" />
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Gemeinsam sperren', En='Lock together'}"
                                                ToolTip="{core:L De='Sperrt das andere Gerät mit, wenn es seit einer Minute unbenutzt ist.', En='Locks the other device too when it has been unused for a minute.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkLockTogether}" />
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <!-- One device shows everything, the other stays quiet: no message twice -->
                        <TextBlock Style="{StaticResource ST.Group}" Text="{core:L De='Hauptgerät', En='Main device'}" />
                        <Border Style="{StaticResource S.Card}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Alles zeigt', En='Everything shows on'}"
                                                ToolTip="{core:L De='Das andere Gerät schickt seine Einblendungen dorthin und bleibt still.', En='The other device sends its peeks there and stays quiet.'}">
                                    <Border Style="{StaticResource S.Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource S.Segment}" GroupName="LinkMain" Content="{core:L De='Beide', En='Both'}"
                                                         IsChecked="{Binding I.Link.MainChoice, Converter={StaticResource EqBool}, ConverterParameter=0}" />
                                            <RadioButton Style="{StaticResource S.Segment}" GroupName="LinkMain" Content="{core:L De='Dieses Gerät', En='This device'}"
                                                         IsChecked="{Binding I.Link.MainChoice, Converter={StaticResource EqBool}, ConverterParameter=1}" />
                                            <RadioButton Style="{StaticResource S.Segment}" GroupName="LinkMain" Content="{Binding I.Link.OtherName}"
                                                         IsChecked="{Binding I.Link.MainChoice, Converter={StaticResource EqBool}, ConverterParameter=2}" />
                                            <RadioButton Style="{StaticResource S.Segment}" GroupName="LinkMain" Content="{core:L De='Automatisch', En='Automatic'}"
                                                         IsChecked="{Binding I.Link.MainChoice, Converter={StaticResource EqBool}, ConverterParameter=3}"
                                                         ToolTip="{core:L De='Wo die Maus ist (CursorHop), sonst das zuletzt benutzte Gerät.', En='Where the mouse is (CursorHop), else the device used last.'}" />
                                        </StackPanel>
                                    </Border>
                                </ContentControl>
                                <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Insel auf dem anderen Gerät ausblenden', En='Hide the island on the other device'}"
                                                ToolTip="{core:L De='Solange beide verbunden sind, zeigt nur das Hauptgerät die Insel.', En='While both are connected, only the main device shows the island.'}">
                                    <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.LinkHideWhenNotMain}" />
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource ST.Group}" Text="CursorHop" />
                    <Border Style="{StaticResource S.Card}" Padding="16,12" Visibility="{Binding I.CursorHop.IsInstalled, Converter={StaticResource NotVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" VerticalAlignment="Center" Click="OpenCursorHopWebsite_Click">
                                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" /><TextBlock Margin="6,0,0,0" Text="cursorhop.com" /></StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ST.Label}" Text="{core:L De='Nicht installiert', En='Not installed'}" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Eine Maus und Tastatur für mehrere PCs. Ohne CursorHop bleibt dieser Teil aus.', En='One mouse and keyboard for several PCs. Without CursorHop this part stays off.'}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Visibility="{Binding I.CursorHop.IsInstalled, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='CursorHop einbinden', En='Use CursorHop'}"
                                            ToolTip="{core:L De='Zeigt Verbindung und Maus in der Insel.', En='Shows the connection and the mouse in the island.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CursorHopEnabled}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.CursorHopEnabled}" Tag="{core:L De='Mit DynamicBay starten', En='Start with DynamicBay'}"
                                            ToolTip="{core:L De='Startet CursorHop, falls es nicht läuft, auch nach dem Aufwachen.', En='Starts CursorHop if it is not running, also after sleep.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CursorHopAutoStart}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.CursorHopEnabled}" Tag="{core:L De='Kurz anzeigen', En='Peeks'}"
                                            ToolTip="{core:L De='Verbunden, getrennt und Zwischenablage vom anderen Gerät.', En='Connected, disconnected and clipboard from the other device.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CursorHopPeeks}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" IsEnabled="{Binding S.CursorHopEnabled}" Tag="{core:L De='Eigene Einblendungen von CursorHop ausblenden', En='Hide CursorHop pop-ups'}"
                                            ToolTip="{core:L De='Empfangen und Übertragung fertig zeigt nur noch die Insel.', En='Only the island shows receiving and transfer complete.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.CursorHopHideOverlays}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 14 Advanced -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=14}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Erweitert', En='Advanced'}" />
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="{core:L De='Bildrate', En='Frame rate'}"
                                            ToolTip="{core:L De='Maximal ist am flüssigsten, 30 oder 60 sparen Strom.', En='Maximum is smoothest, 30 or 60 save power.'}">
                                <Border Style="{StaticResource S.Segments}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource S.Segment}" Content="30" IsChecked="{Binding S.FrameRate, Converter={StaticResource EqBool}, ConverterParameter=30}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="60" IsChecked="{Binding S.FrameRate, Converter={StaticResource EqBool}, ConverterParameter=60}" />
                                        <RadioButton Style="{StaticResource S.Segment}" Content="{core:L De='Maximal', En='Maximum'}" IsChecked="{Binding S.FrameRate, Converter={StaticResource EqBool}, ConverterParameter=0}" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Grafikkarte verwenden', En='Use graphics card'}"
                                            ToolTip="{core:L De='Aus spart Speicher und Strom. Nur einschalten, wenn es ruckelt.', En='Off saves memory and power. Only turn on if it stutters.'}">
                                <CheckBox Style="{StaticResource S.Switch}" IsChecked="{Binding S.GpuRendering}" />
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Protokolle und Daten', En='Logs and data'}"
                                            ToolTip="{core:L De='Log-Dateien, Einstellungen und Ablage. Hilfreich bei Problemen.', En='Log files, settings and shelf. Useful when something goes wrong.'}">
                                <Button x:Name="DataFolderButton" Style="{StaticResource S.PathButton}" Click="OpenDataFolder_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" /><TextBlock x:Name="DataFolderText" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </Button>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Einstellungen übertragen', En='Transfer settings'}"
                                            ToolTip="{core:L De='Alle Einstellungen in eine Datei mit Zahlencode, ohne Anmeldungen.', En='All settings in one file locked with a code, without sign-ins.'}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource S.Button}" Click="ExportSettings_Click">
                                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Download}" Width="14" Height="14" /><TextBlock Margin="8,0,0,0" Text="{core:L De='Exportieren', En='Export'}" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="ImportSettings_Click">
                                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.FolderOpen}" Width="14" Height="14" /><TextBlock Margin="8,0,0,0" Text="{core:L De='Importieren', En='Import'}" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                            <TextBlock x:Name="TransferStatus" Style="{StaticResource ST.Desc}" Margin="16,0,16,10" TextWrapping="Wrap" Visibility="Collapsed" />
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='DynamicBay beenden', En='Quit DynamicBay'}"
                                            ToolTip="{core:L De='Auch in der Insel: Alt halten, der Ausblenden-Knopf wird zum Beenden-Knopf.', En='Also in the island: hold Alt and the hide button turns into a quit button.'}">
                                <Button Style="{StaticResource S.Button}" Command="{Binding I.QuitCommand}" Foreground="{DynamicResource S.Red}"
                                        Content="{core:L De='Beenden', En='Quit'}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 15 About -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=15}">
                    <TextBlock Style="{StaticResource ST.PageTitle}" Text="{core:L De='Über DynamicBay', En='About DynamicBay'}" />
                    <Border Style="{StaticResource S.Card}" Padding="20">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="/Assets/DynamicBay.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,18,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ST.Base}" FontSize="18" FontWeight="Bold" Text="DynamicBay" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{Binding VersionText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource ST.Desc}" Text="{core:L De='Eine Dynamic Island für Windows. Open Source unter MIT-Lizenz.', En='A Dynamic Island for Windows. Open source under the MIT license.'}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Margin="0,8,0,4">
                        <StackPanel>
                            <ContentControl Style="{StaticResource S.Row}" Tag="GitHub" ToolTip="github.com/SuperSparrow-sys/dynamic-island-win">
                                <Button Style="{StaticResource S.Button}" Click="OpenGitHub_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Github}" Width="14" Height="14" /><TextBlock Margin="8,0,0,0" Text="{core:L De='Öffnen', En='Open'}" /></StackPanel>
                                </Button>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Lizenzen', En='Licenses'}"
                                            ToolTip="{core:L De='Lizenzen der verwendeten Bibliotheken, Symbole und Schriften.', En='Licenses of the libraries, icons and fonts used.'}">
                                <Button Style="{StaticResource S.Button}" Click="OpenLicenses_Click">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.FileText}" Width="14" Height="14" /><TextBlock Margin="8,0,0,0" Text="{core:L De='Anzeigen', En='Show'}" /></StackPanel>
                                </Button>
                            </ContentControl>
                            <ContentControl Style="{StaticResource S.Row}" BorderThickness="0,1,0,0" Tag="{core:L De='Danksagungen', En='Credits'}"
                                            ToolTip="{core:L De='Entwickelt mit Claude (Anthropic). Vorbild: NotchNook und die Dynamic Island.', En='Built with Claude (Anthropic). Inspired by NotchNook and the Dynamic Island.'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
