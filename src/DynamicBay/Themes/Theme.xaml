<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DynamicBay.Controls"
                    xmlns:m="clr-namespace:DynamicBay.Motion">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.Lucide.xaml" />
        <ResourceDictionary Source="Icons.Custom.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Font.UI">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

    <!-- Island palette (always dark, Apple system colors for dark appearance) -->
    <Color x:Key="C.Island">#FF000000</Color>
    <SolidColorBrush x:Key="B.Island" Color="{StaticResource C.Island}" />
    <SolidColorBrush x:Key="B.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="B.Text2" Color="#A3FFFFFF" />
    <SolidColorBrush x:Key="B.Text3" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="B.Fill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.Fill2" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="B.Fill3" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="B.Hairline" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="B.Blue" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="B.Green" Color="#FF30D158" />
    <SolidColorBrush x:Key="B.Red" Color="#FFFF453A" />
    <SolidColorBrush x:Key="B.Orange" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="B.Yellow" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="B.Pink" Color="#FFFF375F" />
    <SolidColorBrush x:Key="B.Spotify" Color="#FF1ED760" />

    <!-- Typography -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Headline" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
    </Style>
    <Style x:Key="T.Numeric" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Press feedback: shrink fast, spring back -->
    <Storyboard x:Key="SB.Press">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.9" Duration="0:0:0.12">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.9" Duration="0:0:0.12">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="SB.Release">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction><m:SpringEase Bounce="0.35" /></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction><m:SpringEase Bounce="0.35" /></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Round icon button. Content = Icon. -->
    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Fill2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SB.Press}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SB.Release}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Launcher tile button: no hover plate (the tile itself reacts), springy press -->
    <Style x:Key="Btn.Tile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SB.Press}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SB.Release}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Media transport buttons: no hover plate, just a soft glow on press like iOS -->
    <Style x:Key="Btn.Media" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- Pill text button -->
    <Style x:Key="Btn.Pill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Fill2}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SB.Press}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SB.Release}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented tab (RadioButton). Content = StackPanel(icon + text) -->
    <Style x:Key="Tab.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="999" Padding="10,5">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Fill2}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin rounded progress (media timeline) -->
    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Fill3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card surface inside the expanded island -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Fill}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Minimal scroll viewer: overlay thumb, no arrows -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource B.Fill3}" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="4" />
                <Setter Property="MinHeight" Value="4" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F21C1C1E" CornerRadius="8" Padding="8,4" BorderBrush="{StaticResource B.Hairline}" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Icon">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <!-- Uniform app tile for the launcher (glyph on a squircle, or the original icon inside one). DataContext: ShortcutItem -->
    <c:BoolToVis x:Key="Theme.Vis" />
    <DataTemplate x:Key="AppTile">
        <Grid Width="38" Height="38">
            <Border CornerRadius="10" Background="{Binding TileBackground}" BorderBrush="#14FFFFFF" BorderThickness="0.75" />
            <Border x:Name="Lift" CornerRadius="10" Background="#14FFFFFF" Opacity="0" />
            <c:Icon x:Name="Glyph" Data="{Binding Glyph}" Filled="{Binding GlyphFilled}" StrokeWidth="2" Width="19" Height="19" Foreground="{Binding GlyphBrush}"
                    Visibility="{Binding ShowGlyph, Converter={StaticResource Theme.Vis}}" />
            <Image x:Name="Img" Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding ShowIcon, Converter={StaticResource Theme.Vis}}" />
        </Grid>
        <DataTemplate.Triggers>
            <!-- Hover: the tile lifts slightly and the mark brightens -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter TargetName="Lift" Property="Opacity" Value="1" />
                <Setter TargetName="Glyph" Property="Foreground" Value="#FFF2F2F7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Dark rounded menu used by the island (e.g. "Save to ...") -->
    <Style x:Key="Island.Menu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F21C1C1E" CornerRadius="12" BorderBrush="{StaticResource B.Hairline}" BorderThickness="1" Padding="5" Margin="0,0,10,10">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Direction="270" /></Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Island.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="7" Padding="9,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Blue}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
