<Window x:Class="DynamicBay.Island.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicBay.Controls"
        xmlns:core="clr-namespace:DynamicBay.Core"
        Title="DynamicBay Menu Bar" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Background="#FF1E1E1E" Height="24" Width="800"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <c:BoolToVis x:Key="Vis" />
        <!-- Dark by default; ApplyTheme swaps both for the light Windows theme -->
        <SolidColorBrush x:Key="Bar.Fore" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="Bar.Hover" Color="#24FFFFFF" />
        <Style TargetType="c:Icon">
            <Setter Property="Foreground" Value="{DynamicResource Bar.Fore}" />
        </Style>
        <Style x:Key="Bar.Text" TargetType="TextBlock">
            <!-- The Windows 11 system font like the taskbar; Inter looked foreign at this size. -->
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.Fore}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A status item: one symbol (Fluent), clicks open the Windows quick settings -->
        <Style x:Key="Bar.Item" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="7,0" Margin="1,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bar.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6,0">
        <!-- Left like the Mac: the start menu where the Apple menu sits, pinned and open apps (taskbar), the app in front -->
        <Grid x:Name="LeftSide" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Bar.Item}" Click="Start_Click" Visibility="{Binding ShowStart, Converter={StaticResource Vis}}">
                <c:Icon Data="{StaticResource Glyph.Start}" Filled="True" Width="14" Height="14" />
            </Button>
            <!-- Filled in code: the apps that fit before the notch (RunningApps.Fit), the rest behind "more" -->
            <ItemsControl x:Name="AppList" Grid.Column="1" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Bar.Item}" Click="App_Click" MouseUp="App_MouseUp" MouseRightButtonUp="App_RightClick" ToolTip="{Binding Name}">
                            <Grid Width="16" Height="20">
                                <!-- Inside a template the window's implicit style does not apply: the colour is set here.
                                     App icons keep their own colours, as in the taskbar: recoloured, Teams and others were
                                     not recognisable. -->
                                <c:Icon Data="{Binding Glyph}" Filled="{Binding GlyphFilled}" Foreground="{DynamicResource Bar.Fore}" Height="16" VerticalAlignment="Top"
                                        Visibility="{Binding NoIcon, Converter={StaticResource Vis}}" />
                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Height="16" VerticalAlignment="Top"
                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                                <!-- Like the taskbar: a dot while it runs, a longer line in front, coloured while it wants attention -->
                                <Border x:Name="Line" Height="2" Width="0" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="0,0,0,-1" Background="{DynamicResource Bar.Fore}" Opacity="0.7" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Indicator}" Value="Running">
                                <Setter TargetName="Line" Property="Width" Value="4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Indicator}" Value="Front">
                                <Setter TargetName="Line" Property="Width" Value="12" />
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Indicator}" Value="Attention">
                                <Setter TargetName="Line" Property="Width" Value="8" />
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                                <Setter TargetName="Line" Property="Background" Value="#FFFF9F0A" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource Bar.Item}" Click="More_Click" Visibility="Collapsed"
                    ToolTip="{core:L De='Weitere Apps', En='More apps'}">
                <Grid Width="16" Height="20">
                    <c:Icon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" />
                    <Border x:Name="MoreLine" Height="2" Width="8" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,-1" Background="#FFFF9F0A" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource Bar.Item}" Click="AppName_Click" HorizontalAlignment="Left"
                    Visibility="{Binding ShowAppName, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Bar.Text}" FontWeight="SemiBold" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </Button>
        </Grid>

        <StackPanel x:Name="RightSide" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Bar.Item}" Click="Media_Click" Visibility="{Binding ShowMedia, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Music}" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Bar.Text}" Text="{Binding MediaText}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="QuickSettings_Click" ToolTip="Bluetooth"
                    Visibility="{Binding ShowBluetooth, Converter={StaticResource Vis}}">
                <c:Icon Data="{Binding BluetoothIcon}" Filled="True" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="QuickSettings_Click" Visibility="{Binding ShowBattery, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Bar.Text}" Margin="0,0,5,0" Text="{Binding BatteryText}" />
                    <c:Icon Data="{Binding BatteryIcon}" Filled="True" Width="18" Height="18" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="QuickSettings_Click" Visibility="{Binding ShowNetwork, Converter={StaticResource Vis}}">
                <c:Icon Data="{Binding NetworkIcon}" Filled="True" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="QuickSettings_Click" Visibility="{Binding ShowVolume, Converter={StaticResource Vis}}">
                <c:Icon Data="{Binding VolumeIcon}" Filled="True" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="Search_Click" AutomationProperties.Name="{core:L De=Suchen, En=Search}" Visibility="{Binding ShowSearch, Converter={StaticResource Vis}}">
                <c:Icon Data="{StaticResource Icon.Search}" Width="15" Height="15" />
            </Button>
            <Button Style="{StaticResource Bar.Item}" Click="Clock_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Bar.Text}" Margin="0,0,8,0" Text="{Binding DateText}" Visibility="{Binding ShowDate, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Bar.Text}" Text="{Binding TimeText}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
