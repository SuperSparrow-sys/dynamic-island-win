<UserControl x:Class="DynamicBay.Island.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DynamicBay.Controls"
             xmlns:core="clr-namespace:DynamicBay.Core"
             xmlns:s="clr-namespace:DynamicBay.Services"
             xmlns:ms="clr-namespace:DynamicBay.Services.M365"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <c:BoolToVis x:Key="Vis" />
        <c:BoolToVis x:Key="NotVis" Invert="True" />
        <c:BoolToVis x:Key="VisHidden" KeepSpace="True" />
        <c:DeviceKindIcon x:Key="KindIcon" />
        <c:BatteryRing x:Key="BatteryValue" />
        <c:BatteryRing x:Key="BatteryBrush" Mode="brush" />
        <c:BatteryRing x:Key="BatteryText" Mode="text" />
        <c:BatteryRing x:Key="PercentRing" />
        <c:BatteryRing x:Key="PercentBrush" Mode="brush" />
        <c:EqualsToVis x:Key="EqVis" />
        <c:EqualsToBool x:Key="EqBool" />
        <c:RatioConverter x:Key="Ratio" />
        <c:PercentToWidth x:Key="PercentWidth" />
        <c:InverseBool x:Key="Not" />
        <c:TextOr x:Key="TodoTitle" Fallback="{core:L De='Aufgaben', En='Tasks'}" />
        <c:BoolPick x:Key="OutputGlyph" True="{StaticResource Icon.Headphones}" False="{StaticResource Icon.Speaker}" />
        <c:BoolPick x:Key="DefaultBg" True="{StaticResource B.Fill2}" False="{x:Static Brushes.Transparent}" />
        <c:BoolPick x:Key="ConnectText" True="{core:L De='Trennen', En='Disconnect'}" False="{core:L De='Verbinden', En='Connect'}" />
        <c:BoolPick x:Key="ConnectBg" True="{StaticResource B.Fill2}" False="{StaticResource B.Blue}" />
        <c:BoolPick x:Key="VolumeGlyph" True="{StaticResource Icon.VolumeOff}" False="{StaticResource Icon.Volume}" />
        <c:Percent01 x:Key="Percent01" />
        <c:BoolPick x:Key="PlayPauseGlyph" True="{StaticResource Glyph.Pause}" False="{StaticResource Glyph.Play}" />
        <c:BoolPick x:Key="LikeBrush" True="{StaticResource B.Pink}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="LikeGlyph" True="{StaticResource Glyph.Heart}" False="{StaticResource Icon.Heart}" />
        <c:BoolPick x:Key="OnBrush" True="{StaticResource B.Green}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="ContactsEmpty" True="{core:L De='Noch keine Kontakte', En='No contacts yet'}" False="{core:L De='In den Einstellungen mit Microsoft verbinden (Timer und Kalender)', En='Connect Microsoft in the settings (Timer and calendar)'}" />
        <c:BoolPick x:Key="TrackBg" True="#330A84FF" False="{StaticResource B.Fill2}" />
        <c:BoolPick x:Key="OverdueBrush" True="{StaticResource B.Red}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="DoneOpacity"><c:BoolPick.True><sys:Double>0.4</sys:Double></c:BoolPick.True><c:BoolPick.False><sys:Double>1</sys:Double></c:BoolPick.False></c:BoolPick>
        <c:BoolPick x:Key="TodoEmpty" True="{core:L De='Keine offenen Aufgaben', En='No open tasks'}" False="{core:L De='In den Einstellungen mit Microsoft verbinden (Timer und Kalender)', En='Connect Microsoft in the settings (Timer and calendar)'}" />
        <c:SameToVis x:Key="SameVis" />
        <c:TextOr x:Key="TeamsHint" Fallback="{core:L De='Mit einem Firmen- oder Schulkonto bei Microsoft verbinden (Einstellungen → Timer und Kalender)', En='Connect a work or school Microsoft account (Settings → Timer and calendar)'}" />
        <c:BoolPick x:Key="LikeTip" True="{core:L De='Aus Lieblingssongs entfernen', En='Remove from Liked Songs'}" False="{core:L De='Zu Lieblingssongs hinzufügen', En='Save to Liked Songs'}" />
        <c:BoolPick x:Key="DimIfFalse"><c:BoolPick.True><sys:Double>1</sys:Double></c:BoolPick.True><c:BoolPick.False><sys:Double>0.35</sys:Double></c:BoolPick.False></c:BoolPick>
        <c:BoolPick x:Key="ShuffleTip" True="{core:L De='Zufallswiedergabe aus', En='Shuffle off'}" False="{core:L De='Zufallswiedergabe an', En='Shuffle on'}" />
        <c:RepeatPick x:Key="RepeatGlyph" Off="{StaticResource Icon.Repeat}" Context="{StaticResource Icon.Repeat}" Track="{StaticResource Icon.RepeatOne}" />
        <c:RepeatPick x:Key="RepeatBrush" Off="{StaticResource B.Text2}" Context="{StaticResource B.Green}" Track="{StaticResource B.Green}" />
        <c:RepeatPick x:Key="RepeatTip" Off="{core:L De='Wiederholen: aus', En='Repeat: off'}" Context="{core:L De='Wiederholen: Playlist oder Album', En='Repeat: playlist or album'}" Track="{core:L De='Wiederholen: dieser Song', En='Repeat: this song'}" />
        <c:BoolPick x:Key="PinBrush" True="{StaticResource B.Blue}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="HideQuitTip" True="{core:L De='DynamicBay beenden', En='Quit DynamicBay'}" False="{core:L De='Ausblenden (mit Alt: Beenden)', En='Hide (with Alt: quit)'}" />
        <c:BoolPick x:Key="MicBrush" True="{StaticResource B.Orange}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="TodayBg" True="{StaticResource B.Red}" False="Transparent" />
        <c:BoolPick x:Key="TodayFg" True="{StaticResource B.Text}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="BatteryGlyph" True="{StaticResource Icon.BatteryCharging}" False="{StaticResource Icon.BatteryMedium}" />

        <!-- Tab label hides in the narrow vertical layout unless selected -->
        <Style x:Key="TabText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVertical}" Value="True" />
                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Fill3}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <ItemsPanelTemplate x:Key="RowPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanel"><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>

        <!-- Hover-revealed overlay buttons on tiles -->
        <!-- Dark glass circles over pictures: hover gets lighter but stays opaque, so the button never fades into the image -->
        <!-- A row in a widget list (projects, sound devices): same height and radius everywhere.
             Radius 10 = card radius 20 minus its padding 10, so the row corners run parallel to the card. -->
        <Style x:Key="Row.Item" TargetType="Button" BasedOn="{StaticResource Btn.Chip}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F23A3A3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF48484A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Delete: turns red on hover -->
        <Style x:Key="TileButton.Danger" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Red}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFD93A30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <DockPanel x:Name="TopBar" Height="44" LastChildFill="False" Background="Transparent">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=0}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Sparkles}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Home}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs" Margin="2,0,0,0"
                             Visibility="{Binding Settings.ShowTrayTab, Converter={StaticResource Vis}}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=1}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Inbox}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Tray}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs" Margin="2,0,0,0"
                             Visibility="{Binding Settings.ShowNotificationsTab, Converter={StaticResource Vis}}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=2}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Bell}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Notifications}" />
                        <Border Style="{StaticResource Badge}" Visibility="{Binding Notifications.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="10" Text="{Binding Notifications.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding Battery.HasBattery, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="11.5" Foreground="{StaticResource B.Text2}"
                               Text="{Binding Battery.Percent, StringFormat={}{0} %}" VerticalAlignment="Center"
                               Visibility="{Binding IsVertical, Converter={StaticResource NotVis}}" />
                    <c:Icon Margin="5,0,0,0" Width="18" Height="18" StrokeWidth="1.8"
                            Data="{Binding Battery.IsPluggedIn, Converter={StaticResource BatteryGlyph}}"
                            Foreground="{Binding Battery.IsPluggedIn, Converter={StaticResource OnBrush}}" />
                </StackPanel>
                <!-- Microphone mute: orange while an app records, red when muted -->
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding Audio.ToggleMicMuteCommand}" ToolTip="{core:L De='Mikrofon stummschalten (Strg+Alt+M)', En='Mute microphone (Ctrl+Alt+M)'}"
                        Visibility="{Binding Settings.AudioEnabled, Converter={StaticResource Vis}}">
                    <Grid>
                        <c:Icon Data="{StaticResource Icon.Mic}" Width="15" Height="15" Foreground="{Binding Audio.MicInUse, Converter={StaticResource MicBrush}}"
                                Visibility="{Binding Audio.MicMuted, Converter={StaticResource NotVis}}" />
                        <c:Icon Data="{StaticResource Icon.MicOff}" Width="15" Height="15" Foreground="{StaticResource B.Red}"
                                Visibility="{Binding Audio.MicMuted, Converter={StaticResource Vis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding TogglePinCommand}" ToolTip="{core:T Action.Pin}">
                    <c:Icon Data="{StaticResource Icon.Pin}" Width="14" Height="14" Foreground="{Binding IsPinned, Converter={StaticResource PinBrush}}" />
                </Button>
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="{core:T Action.Settings}">
                    <c:Icon Data="{StaticResource Icon.Settings}" Width="15" Height="15" Foreground="{StaticResource B.Text2}" />
                </Button>
                <!-- Hide; with Alt held it becomes the (hidden) quit button.
                     Corner button: its centre sits 34 px from the top and from the side (12 inset + half the 44 px bar),
                     so it is centred in the panel corner like the first tab on the other side. -->
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding HideCommand}" Margin="0,0,7,0"
                        ToolTip="{Binding AltHeld, Converter={StaticResource HideQuitTip}}">
                    <Grid>
                        <c:Icon Data="{StaticResource Icon.EyeOff}" Width="15" Height="15" Foreground="{StaticResource B.Text2}"
                                Visibility="{Binding AltHeld, Converter={StaticResource NotVis}}" />
                        <c:Icon Data="{StaticResource Icon.Power}" Width="15" Height="15" Foreground="{StaticResource B.Red}" StrokeWidth="2.3"
                                Visibility="{Binding AltHeld, Converter={StaticResource Vis}}" />
                    </Grid>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ===== Pages ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">

            <!-- Home: media, calendar, timer -->
            <!-- Nook page scrolls when the chosen widgets need more room than the island has -->
            <ScrollViewer x:Name="HomeScroll" Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=0}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="HomeScroll_Wheel" SizeChanged="HomeScroll_SizeChanged">
            <Grid x:Name="HomeGrid">

                <!-- Media card -->
                <Border x:Name="MediaCard" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Nothing playing -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Media.HasSession, Converter={StaticResource NotVis}}">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource B.Fill2}" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="20" Height="20" Foreground="{StaticResource B.Text3}" />
                            </Border>
                            <TextBlock Style="{StaticResource T.Title}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="{core:T Media.Nothing}" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Media.NothingHint}" />
                        </StackPanel>

                        <!-- Now playing -->
                        <Grid Visibility="{Binding Media.HasSession, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CoverHost" Width="96" Height="96" VerticalAlignment="Top">
                                <Border CornerRadius="10" Background="{StaticResource B.Fill2}">
                                    <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="30" Height="30" Foreground="{StaticResource B.Text3}" />
                                </Border>
                                <Border CornerRadius="10" x:Name="CoverArt">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Media.Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Width="22" Height="22" CornerRadius="11" Background="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-5" Visibility="{Binding Media.IsSpotify, Converter={StaticResource Vis}}">
                                    <c:Icon Data="{StaticResource Glyph.Spotify}" Filled="True" Width="17" Height="17" Foreground="{StaticResource B.Spotify}" />
                                </Border>
                                <!-- Apple Music: generic music note on the service's pink-red gradient (no Apple logo) -->
                                <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-5" BorderBrush="Black" BorderThickness="1.5" Visibility="{Binding Media.IsAppleMusic, Converter={StaticResource Vis}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFC5C7D" Offset="0" />
                                            <GradientStop Color="#FFFA233B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="12" Height="12" Foreground="White" />
                                </Border>
                            </Grid>

                            <!-- Music volume (only the player, not the PC): under the cover, level with the transport buttons.
                                 Click or drag the bar, scroll over it; the speaker mutes the music. -->
                            <DockPanel x:Name="VolumeRow" Width="96" Height="42" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                       Visibility="{Binding MusicVolume.IsAvailable, Converter={StaticResource Vis}}"
                                       ToolTip="{Binding MusicVolume.Tip}">
                                <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="20" Height="20" Margin="-3,0,3,0" Click="VolumeMute_Click">
                                    <c:Icon Width="13" Height="13" Foreground="{StaticResource B.Text2}"
                                            Data="{Binding MusicVolume.IsMuted, Converter={StaticResource VolumeGlyph}}" />
                                </Button>
                                <Grid x:Name="VolumeBar" Height="16" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Volume_MouseDown" MouseMove="Volume_MouseMove" MouseLeftButtonUp="Volume_MouseUp" MouseWheel="Volume_Wheel">
                                    <Border x:Name="VolumeTrack" Height="4" CornerRadius="3" Background="{StaticResource B.Fill3}" VerticalAlignment="Center" />
                                    <Canvas ClipToBounds="False">
                                        <Grid Height="16">
                                            <Grid.Width>
                                                <MultiBinding Converter="{StaticResource PercentWidth}">
                                                    <Binding Path="MusicVolume.Level" />
                                                    <Binding Path="ActualWidth" ElementName="VolumeBar" />
                                                </MultiBinding>
                                            </Grid.Width>
                                            <Border x:Name="VolumeFill" Height="4" CornerRadius="3" Background="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                            <Border x:Name="VolumeKnob" Width="12" Height="12" CornerRadius="6" Margin="0,0,-6,0" Background="{StaticResource B.Text}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                                                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                                            </Border>
                                        </Grid>
                                    </Canvas>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="VolumeKnob" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                    <DoubleAnimation Storyboard.TargetName="VolumeTrack" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                    <DoubleAnimation Storyboard.TargetName="VolumeFill" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="VolumeKnob" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetName="VolumeTrack" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetName="VolumeFill" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DockPanel>

                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <c:Waveform DockPanel.Dock="Right" Width="18" Height="13" Margin="8,2,0,0" VerticalAlignment="Top"
                                                IsPlaying="{Binding Media.IsPlaying}" BarBrush="{Binding Media.AccentBrush}" />
                                    <!-- Long titles wrap onto a second line and are then shortened; the text never widens the card. -->
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Style="{StaticResource T.Headline}" Text="{Binding Media.Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38" ToolTip="{Binding Media.Title}" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,1,0,0" FontSize="12.5" Text="{Binding Media.Artist}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Timeline: click or drag to seek; on hover the bar thickens and shows its knob -->
                                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                    <Grid x:Name="Timeline" Height="16" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp">
                                        <Border x:Name="TimelineTrack" Height="4" CornerRadius="3" Background="{StaticResource B.Fill3}" VerticalAlignment="Center" />
                                        <!-- Fill and knob sit on a Canvas: it asks for no size, so the bar can never make the card wider.
                                             (Before, the knob poking out of the full bar widened the card, which lengthened the bar - an endless layout loop.) -->
                                        <Canvas ClipToBounds="False">
                                            <Grid Height="16">
                                                <Grid.Width>
                                                    <MultiBinding Converter="{StaticResource Ratio}">
                                                        <Binding Path="Media.PositionSeconds" />
                                                        <Binding Path="Media.DurationSeconds" />
                                                        <Binding Path="ActualWidth" ElementName="Timeline" />
                                                    </MultiBinding>
                                                </Grid.Width>
                                                <Border x:Name="TimelineFill" Height="4" CornerRadius="3" Background="{StaticResource B.Text}" VerticalAlignment="Center" />
                                                <Border x:Name="TimelineKnob" Width="12" Height="12" CornerRadius="6" Margin="0,0,-6,0" Background="{StaticResource B.Text}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                                                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                                                </Border>
                                            </Grid>
                                        </Canvas>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TimelineKnob" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineTrack" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineFill" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TimelineKnob" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineTrack" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineFill" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource T.Numeric}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource B.Text3}" Text="{Binding Media.RemainingText}" />
                                        <TextBlock HorizontalAlignment="Left" Style="{StaticResource T.Numeric}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource B.Text3}" Text="{Binding Media.PositionText}" />
                                        <!-- A Spotify action failed (no Premium, no active device): short note between the times -->
                                        <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="Medium" Foreground="{StaticResource B.Orange}" TextTrimming="CharacterEllipsis" Margin="34,0"
                                                   Text="{Binding Spotify.PlayerError}" Visibility="{Binding Spotify.PlayerError, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Transport -->
                                <!-- Like | previous, play, next | devices: own columns, so nothing overlaps on a narrow card -->
                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                    <!-- Slimmer side buttons, so all seven fit in the narrow card (upright island) without cutting off the last one -->
                                    <Grid.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}" x:Key="Btn.Side">
                                            <Setter Property="Width" Value="26" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding Spotify.IsConnected, Converter={StaticResource Vis}}">
                                        <Button Style="{StaticResource Btn.Side}" Command="{Binding Spotify.ToggleShuffleCommand}"
                                                Opacity="{Binding Spotify.CanShuffle, Converter={StaticResource DimIfFalse}}"
                                                ToolTip="{Binding Spotify.Shuffle, Converter={StaticResource ShuffleTip}}">
                                            <c:Icon Width="16" Height="16" Data="{StaticResource Icon.Shuffle}" Foreground="{Binding Spotify.Shuffle, Converter={StaticResource OnBrush}}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Side}" Command="{Binding Spotify.ToggleLikeCommand}"
                                                ToolTip="{Binding Spotify.IsLiked, Converter={StaticResource LikeTip}}">
                                            <c:Icon Width="16" Height="16" Data="{Binding Spotify.IsLiked, Converter={StaticResource LikeGlyph}}"
                                                    Filled="{Binding Spotify.IsLiked}" Foreground="{Binding Spotify.IsLiked, Converter={StaticResource LikeBrush}}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Media}" Command="{Binding Media.PreviousCommand}">
                                            <c:Icon Data="{StaticResource Glyph.Previous}" Filled="True" Width="20" Height="20" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Media}" Width="42" Height="42" Margin="4,0" Command="{Binding Media.PlayPauseCommand}">
                                            <c:Icon Data="{Binding Media.IsPlaying, Converter={StaticResource PlayPauseGlyph}}" Filled="True" Width="26" Height="26" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Media}" Command="{Binding Media.NextCommand}">
                                            <c:Icon Data="{StaticResource Glyph.Next}" Filled="True" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Spotify.IsConnected, Converter={StaticResource Vis}}">
                                        <Button Style="{StaticResource Btn.Side}" Command="{Binding Spotify.CycleRepeatCommand}" ToolTip="{Binding Spotify.Repeat, Converter={StaticResource RepeatTip}}"
                                                Opacity="{Binding Spotify.CanRepeat, Converter={StaticResource DimIfFalse}}">
                                            <c:Icon Width="16" Height="16" Data="{Binding Spotify.Repeat, Converter={StaticResource RepeatGlyph}}"
                                                    Foreground="{Binding Spotify.Repeat, Converter={StaticResource RepeatBrush}}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Side}" Click="Devices_Click" ToolTip="{core:T Media.Devices}">
                                            <c:Icon Data="{StaticResource Icon.Devices}" Width="16" Height="16" Foreground="{StaticResource B.Text2}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Spotify device picker overlay -->
                        <Border x:Name="DevicesOverlay" Visibility="Collapsed" Background="#F2161618" CornerRadius="16" Margin="-6">
                            <DockPanel Margin="12,8">
                                <DockPanel DockPanel.Dock="Top" Height="22">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Click="DevicesClose_Click">
                                        <c:Icon Data="{StaticResource Icon.Close}" Width="13" Height="13" Foreground="{StaticResource B.Text2}" />
                                    </Button>
                                    <TextBlock Style="{StaticResource T.Section}" Text="{core:T Media.Devices}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Spotify.Devices}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:SpotifyDevice}">
                                            <Button Style="{StaticResource Btn.Pill}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="8,5"
                                                    Command="{Binding DataContext.Spotify.TransferToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <c:Icon Data="{StaticResource Icon.Speaker}" Width="14" Height="14" Foreground="{Binding IsActive, Converter={StaticResource OnBrush}}" />
                                                    <TextBlock Style="{StaticResource T.Base}" Margin="8,0,0,0" Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Calendar card -->
                <Border x:Name="CalendarCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource T.Title}" Foreground="{StaticResource B.Red}" Text="{Binding Calendar.MonthText}" />
                        </DockPanel>
                        <!-- Fixed-width day cells scaled as a whole, so the "today" circle stays round in narrow cards -->
                        <Viewbox DockPanel.Dock="Top" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="-2,6,-2,0">
                        <ItemsControl ItemsSource="{Binding Calendar.Week}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type s:DayCell}">
                                    <!-- Tap a day to see its events; the chosen day gets a ring, today stays red; a dot marks days with events -->
                                    <StackPanel HorizontalAlignment="Center" Width="23" Background="Transparent" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.Calendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </StackPanel.InputBindings>
                                        <TextBlock Style="{StaticResource T.Section}" FontSize="8.5" HorizontalAlignment="Center" Text="{Binding Weekday}" />
                                        <Grid Width="20" Height="20" Margin="0,3,0,0">
                                            <Border CornerRadius="10" Background="{Binding IsToday, Converter={StaticResource TodayBg}}" />
                                            <Border CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource B.Text}"
                                                    Visibility="{Binding ShowRing, Converter={StaticResource Vis}}" />
                                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding IsToday, Converter={StaticResource TodayFg}}" Text="{Binding Day}" />
                                        </Grid>
                                        <Border Width="3" Height="3" CornerRadius="1.5" Margin="0,2,0,0" Background="{StaticResource B.Text3}"
                                                Visibility="{Binding HasEvents, Converter={StaticResource VisHidden}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Viewbox>

                        <Grid Margin="0,8,0,0">
                            <!-- Events of the chosen day: all-day ones on top, then the timed ones (scrolls when there are many) -->
                            <DockPanel Visibility="{Binding Calendar.DayIsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Calendar.DayAllDay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:CalendarEvent}">
                                            <Border CornerRadius="6" Background="{Binding SoftBrush}" Padding="7,3" Margin="0,0,0,4">
                                                <TextBlock Style="{StaticResource T.Title}" FontSize="11" Foreground="{StaticResource B.Text}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding Calendar.DayEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type s:CalendarEvent}">
                                                <DockPanel Margin="0,0,0,7">
                                                    <!-- Teams/Zoom meeting: join with one click -->
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Chip}" Padding="8,3" FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Background="#3330D158" Foreground="{StaticResource B.Green}"
                                                            Visibility="{Binding HasMeeting, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.Calendar.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            ToolTip="{Binding JoinText, StringFormat={}{0}-Meeting beitreten}">
                                                        <TextBlock Text="{core:L De='Beitreten', En='Join'}" />
                                                    </Button>
                                                    <Border Width="3" CornerRadius="1.5" Background="{Binding Brush}" Margin="0,1,8,1" />
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource T.Title}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Margin="0,1,0,0" Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding Calendar.DayIsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Calendar}" Width="16" Height="16" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           Text="{Binding Calendar.DayEmptyText}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Timer card -->
                <Border x:Name="TimerCard" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Idle: presets -->
                        <DockPanel Visibility="{Binding Timer.IsActive, Converter={StaticResource NotVis}}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                                <c:Icon Data="{StaticResource Icon.Timer}" Width="14" Height="14" Foreground="{StaticResource B.Orange}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:T Timer.Title}" />
                            </StackPanel>
                            <!-- Today's focus sessions (only once there is one) -->
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T.Caption}" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Work.FocusToday}" Visibility="{Binding Work.FocusToday, Converter={StaticResource Vis}}" />
                            <UniformGrid Columns="2" Rows="2" Margin="0,10,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Chip}" Margin="0,0,3,3" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>1</sys:Double></Button.CommandParameter>1 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="3,0,0,3" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>5</sys:Double></Button.CommandParameter>5 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="0,3,3,0" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>10</sys:Double></Button.CommandParameter>10 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="3,3,0,0" Padding="0,7" Height="32" Background="#33FF9F0A" Foreground="{StaticResource B.Orange}"
                                        Command="{Binding Timer.StartFocusCommand}" Content="{core:T Timer.Pomodoro}" />
                            </UniformGrid>
                        </DockPanel>

                        <!-- Running -->
                        <Grid Visibility="{Binding Timer.IsActive, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Width="78" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:ProgressRing Thickness="5" Value="{Binding Timer.Progress}" RingBrush="{StaticResource B.Orange}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="17" HorizontalAlignment="Center" Text="{Binding Timer.RemainingText}" />
                                    <TextBlock Style="{StaticResource T.Section}" FontSize="9.5" HorizontalAlignment="Center" Text="{Binding Timer.ModeText}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Background="{StaticResource B.Fill2}" Command="{Binding Timer.StopCommand}" ToolTip="{core:T Timer.Reset}">
                                    <c:Icon Data="{StaticResource Icon.Close}" Width="13" Height="13" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="8,0,0,0" Background="#33FF9F0A" Command="{Binding Timer.TogglePauseCommand}">
                                    <c:Icon Data="{Binding Timer.IsRunning, Converter={StaticResource PlayPauseGlyph}}" Filled="True" Width="13" Height="13" Foreground="{StaticResource B.Orange}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Optional widgets (shown when enabled in settings; laid out in code) -->
            <Grid x:Name="ExtraCards" Visibility="Collapsed">
                <!-- Contacts: frequent people with Teams chat, Teams call and phone (via Smartphone-Link) -->
                <Border x:Name="ContactsCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.User}" Width="14" Height="14" Foreground="{StaticResource B.Green}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Kontakte', En='Contacts'}" />
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Contacts.IsEmpty, Converter={StaticResource Vis}}"
                                       Text="{Binding Microsoft.IsConnected, Converter={StaticResource ContactsEmpty}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Contacts.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ms:ContactItem}">
                                            <DockPanel Margin="0,0,0,6" ToolTip="{Binding Detail}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="{core:L De='Teams-Chat', En='Teams chat'}"
                                                            Visibility="{Binding HasEmail, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.Contacts.ChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Chat}" Width="13" Height="13" Foreground="{StaticResource B.Blue}" />
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="{core:L De='Teams-Anruf', En='Teams call'}"
                                                            Visibility="{Binding HasEmail, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.Contacts.TeamsCallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Video}" Width="13" Height="13" Foreground="{StaticResource B.Blue}" />
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="{core:L De='Anrufen (Smartphone-Link)', En='Call (Phone Link)'}"
                                                            Visibility="{Binding HasPhone, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.Contacts.CallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Call}" Width="13" Height="13" Foreground="{StaticResource B.Green}" />
                                                    </Button>
                                                </StackPanel>
                                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource B.Fill2}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initials}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Time tracking: tap a project to start or switch, tap the running one (or the square) to stop -->
                <Border x:Name="TimeCard" Style="{StaticResource Card}" Padding="10" Cursor="Hand" MouseLeftButtonUp="TimeCard_Click"
                        ToolTip="{core:L De='Klicken: Zeiterfassung öffnen (Einträge, nachtragen, Projekte)', En='Click: open time tracking (entries, add time, projects)'}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="22">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Time.StopCommand}" ToolTip="{core:L De='Stoppen', En='Stop'}"
                                        Visibility="{Binding Time.IsRunning, Converter={StaticResource Vis}}">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{StaticResource B.Red}" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Click="AddTimeProject_Click"
                                        ToolTip="{core:L De='Projekt hinzufügen', En='Add project'}">
                                    <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding OpenTimeTrackingCommand}"
                                        ToolTip="{core:L De='Zeiterfassung öffnen', En='Open time tracking'}">
                                    <c:Icon Data="{StaticResource Icon.External}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Clock}" Width="14" Height="14" Foreground="{StaticResource B.Blue}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Zeit', En='Time'}" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Time.TodayTotal, StringFormat={}{0} h}"
                                           ToolTip="{core:L De='Heute insgesamt', En='Today in total'}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- new project (from the "+") -->
                        <TextBox x:Name="NewTimeProject" DockPanel.Dock="Top" Margin="0,6,0,0" Visibility="Collapsed" Padding="6,4" FontSize="11.5"
                                 Background="{StaticResource B.Fill2}" Foreground="{StaticResource B.Text}" CaretBrush="{StaticResource B.Text}" BorderThickness="0"
                                 KeyDown="NewTimeProject_KeyDown" LostKeyboardFocus="NewTimeProject_LostFocus" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T.Caption}" FontSize="9.5" Foreground="{StaticResource B.Orange}" TextWrapping="Wrap"
                                   Text="{Binding Time.Status}" Visibility="{Binding Time.Status, Converter={StaticResource Vis}}" />
                        <!-- running: project and time -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0" Visibility="{Binding Time.IsRunning, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource B.Blue}" Text="{Binding Time.Elapsed}" />
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis" Text="{Binding Time.CurrentProject}" />
                        </StackPanel>
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Time.Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ProjectTotal}">
                                        <Button Style="{StaticResource Row.Item}"
                                                Background="{Binding Running, Converter={StaticResource TrackBg}}"
                                                Command="{Binding DataContext.Time.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Project}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Numeric}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource B.Text2}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Today}" />
                                                <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Project}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Microsoft To Do: open tasks, overdue and today's first; tick them off here -->
                <Border x:Name="TodoCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="22">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Todo.OpenAppCommand}" ToolTip="Microsoft To Do">
                                <c:Icon Data="{StaticResource Icon.External}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{StaticResource B.Blue}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Settings.TodoListName, Converter={StaticResource TodoTitle}}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Todo.IsEmpty, Converter={StaticResource Vis}}"
                                       Text="{Binding Microsoft.IsConnected, Converter={StaticResource TodoEmpty}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Todo.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ms:TodoItem}">
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.Todo.CompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        ToolTip="{core:L De='Erledigt', En='Done'}">
                                                    <Grid>
                                                        <Border Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource B.Text2}" />
                                                        <c:Icon Data="{StaticResource Icon.Check}" Width="10" Height="10" StrokeWidth="3" Foreground="{StaticResource B.Blue}"
                                                                Visibility="{Binding Done, Converter={StaticResource Vis}}" />
                                                    </Grid>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding Title}"
                                                               Opacity="{Binding Done, Converter={StaticResource DoneOpacity}}" />
                                                    <TextBlock Style="{StaticResource T.Caption}" FontSize="10" Text="{Binding DueText}"
                                                               Foreground="{Binding Overdue, Converter={StaticResource OverdueBrush}}"
                                                               Visibility="{Binding DueText, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Teams status: a narrow column of coloured dots; the current one has a ring, click one to switch -->
                <Border x:Name="TeamsCard" Style="{StaticResource Card}" Padding="6,10" ToolTip="{Binding Presence.Status, Converter={StaticResource TeamsHint}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding Presence.IsKnown}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{x:Static ms:PresenceService.Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ms:PresenceChoice}">
                                    <Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="0" ToolTip="{Binding Label}"
                                            Command="{Binding DataContext.Presence.SetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Availability}">
                                        <Grid>
                                            <!-- ring around the current status -->
                                            <Ellipse Width="21" Height="21" Stroke="{StaticResource B.Text}" StrokeThickness="1.5">
                                                <Ellipse.Visibility>
                                                    <MultiBinding Converter="{StaticResource SameVis}">
                                                        <Binding Path="Availability" />
                                                        <Binding Path="DataContext.Presence.Selected" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Ellipse.Visibility>
                                            </Ellipse>
                                            <Grid Visibility="{Binding Reset, Converter={StaticResource NotVis}}">
                                                <Ellipse Width="13" Height="13" Fill="{Binding Brush}" Stroke="{Binding Brush}" StrokeThickness="2"
                                                         Visibility="{Binding Hollow, Converter={StaticResource NotVis}}" />
                                                <Ellipse Width="13" Height="13" Stroke="{Binding Brush}" StrokeThickness="2.5"
                                                         Visibility="{Binding Hollow, Converter={StaticResource Vis}}" />
                                                <!-- do not disturb: white bar -->
                                                <Rectangle Width="7" Height="2" RadiusX="1" RadiusY="1" Fill="White" Visibility="{Binding Bar, Converter={StaticResource Vis}}" />
                                            </Grid>
                                            <!-- reset: Teams decides again -->
                                            <c:Icon Data="{StaticResource Icon.Reset}" Width="12" Height="12" StrokeWidth="2.4" Foreground="{StaticResource B.Text2}"
                                                    Visibility="{Binding Reset, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Notes: quick, short notes - written in a second, gone in one click -->
                <Border x:Name="NotesCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="22">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Notes.NewCommand}"
                                    ToolTip="{core:L De='Neue Notiz', En='New note'}">
                                <c:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" Foreground="{StaticResource B.Text2}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Pencil}" Width="14" Height="14" Foreground="{StaticResource B.Orange}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Notizen', En='Notes'}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Button Style="{StaticResource Btn.Chip}" Background="{StaticResource B.Fill2}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,6"
                                    Command="{Binding Notes.NewCommand}" Visibility="{Binding Notes.IsEmpty, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                    <TextBlock Margin="6,0,0,0" FontWeight="Normal" Text="{core:L De='Kurz etwas notieren', En='Jot something down'}" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="NoteList" ItemsSource="{Binding Notes.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:NoteItem}">
                                            <Grid Margin="0,0,0,4">
                                                <TextBox x:Name="NoteBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                                         MaxHeight="96" MinHeight="28" VerticalScrollBarVisibility="Auto" Padding="8,6,22,6" FontSize="11.5" FontFamily="{StaticResource Font.UI}"
                                                         Background="{StaticResource B.Fill2}" Foreground="{StaticResource B.Text}" CaretBrush="{StaticResource B.Text}" BorderThickness="0"
                                                         LostKeyboardFocus="Note_LostFocus" GotKeyboardFocus="Note_GotFocus">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                <Button x:Name="NoteDelete" Style="{StaticResource Btn.Icon}" Width="18" Height="18" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="Hidden" ToolTip="{core:L De='Löschen', En='Delete'}"
                                                        Command="{Binding DataContext.Notes.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource Icon.Close}" Width="10" Height="10" Foreground="{StaticResource B.Text2}" />
                                                </Button>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NoteDelete" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Audio: output and microphone with one click, Bluetooth headsets connect with one click -->
                <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.Headphones}" Width="14" Height="14" Foreground="{StaticResource B.Blue}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="Audio" />
                        </StackPanel>
                        <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Section}" Margin="2,0,0,4" Text="{core:L De='Ausgabe', En='Output'}" />
                                <ItemsControl ItemsSource="{Binding AudioDevices.Outputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:AudioDeviceItem}">
                                            <Button Style="{StaticResource Row.Item}"
                                                    Background="{Binding IsDefault, Converter={StaticResource DefaultBg}}" ToolTip="{Binding Name}"
                                                    Command="{Binding DataContext.AudioDevices.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.Check}" Width="11" Height="11" StrokeWidth="3" Foreground="{StaticResource B.Blue}"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource Vis}}" />
                                                    <c:Icon DockPanel.Dock="Left" Data="{Binding Headphones, Converter={StaticResource OutputGlyph}}" Width="12" Height="12" Margin="0,0,7,0"
                                                            Foreground="{Binding IsDefault, Converter={StaticResource OnBrush}}" />
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource T.Section}" Margin="2,6,0,4" Text="{core:L De='Mikrofon', En='Microphone'}" />
                                <ItemsControl ItemsSource="{Binding AudioDevices.Inputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:AudioDeviceItem}">
                                            <Button Style="{StaticResource Row.Item}"
                                                    Background="{Binding IsDefault, Converter={StaticResource DefaultBg}}" ToolTip="{Binding Name}"
                                                    Command="{Binding DataContext.AudioDevices.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.Check}" Width="11" Height="11" StrokeWidth="3" Foreground="{StaticResource B.Blue}"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource Vis}}" />
                                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Mic}" Width="12" Height="12" Margin="0,0,7,0"
                                                            Foreground="{Binding IsDefault, Converter={StaticResource OnBrush}}" />
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding AudioDevices.HasHeadsets, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource T.Section}" Margin="2,6,0,4" Text="Bluetooth" />
                                    <ItemsControl ItemsSource="{Binding AudioDevices.Headsets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type s:BluetoothAudioItem}">
                                                <DockPanel Height="28" Margin="9,0,0,4" ToolTip="{Binding Name}">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Chip}" Padding="10,0" Height="24" FontSize="11" VerticalAlignment="Center"
                                                            Background="{Binding Connected, Converter={StaticResource ConnectBg}}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"
                                                            Content="{Binding Connected, Converter={StaticResource ConnectText}}"
                                                            Command="{Binding DataContext.AudioDevices.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <c:Icon DockPanel.Dock="Left" Data="{Binding Headphones, Converter={StaticResource OutputGlyph}}" Width="12" Height="12" Margin="0,0,7,0"
                                                            Foreground="{Binding Connected, Converter={StaticResource OnBrush}}" />
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Devices: this PC and connected Bluetooth devices with their battery, like the iPhone battery widget -->
                <Border x:Name="DevicesCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.Bluetooth}" Width="14" Height="14" Foreground="{StaticResource B.Blue}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Geräte', En='Devices'}" />
                        </StackPanel>
                        <Viewbox StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- this PC -->
                                <StackPanel Width="60" Visibility="{Binding Battery.HasBattery, Converter={StaticResource Vis}}">
                                    <Grid Width="46" Height="46">
                                        <c:ProgressRing Thickness="4" Value="{Binding Battery.Percent, Converter={StaticResource PercentRing}}"
                                                        RingBrush="{Binding Battery.Percent, Converter={StaticResource PercentBrush}}" />
                                        <c:Icon Data="{StaticResource Icon.Laptop}" Width="18" Height="18" Foreground="{StaticResource B.Text}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                               Text="{Binding Battery.Percent, StringFormat={}{0} %}" />
                                    <TextBlock Style="{StaticResource T.Caption}" FontSize="9.5" HorizontalAlignment="Center" Text="{core:L De='Dieser PC', En='This PC'}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Bluetooth.Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:BluetoothDeviceInfo}">
                                            <StackPanel Width="60" ToolTip="{Binding Name}">
                                                <Grid Width="46" Height="46">
                                                    <c:ProgressRing Thickness="4" Value="{Binding Battery, Converter={StaticResource BatteryValue}}"
                                                                    RingBrush="{Binding Battery, Converter={StaticResource BatteryBrush}}" />
                                                    <c:Icon Data="{Binding Kind, Converter={StaticResource KindIcon}}" Width="18" Height="18" Foreground="{StaticResource B.Text}" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource T.Numeric}" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                                           Text="{Binding Battery, Converter={StaticResource BatteryText}}" />
                                                <TextBlock Style="{StaticResource T.Caption}" FontSize="9.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="56" Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- Clock -->
                <Border x:Name="ClockCard" Style="{StaticResource Card}" Padding="10" Cursor="Hand" MouseLeftButtonUp="ClockCard_Click"
                        ToolTip="{core:L De='Klicken: Ziffern oder Zifferblatt', En='Click: digits or dial'}">
                    <Grid>
                    <!-- Dial like the iPhone Clock icon -->
                    <c:AnalogClock Margin="4" Visibility="{Binding Settings.ClockAnalog, Converter={StaticResource Vis}}" />
                    <!-- Digits: scale down in narrow slots instead of clipping -->
                    <Viewbox StretchDirection="DownOnly" Visibility="{Binding Settings.ClockAnalog, Converter={StaticResource NotVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Foreground="{StaticResource B.Orange}" Text="{Binding Clock.Weekday}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="38" FontWeight="Bold" Text="{Binding Clock.Time}" />
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="18" Foreground="{StaticResource B.Text2}" Margin="1,0,0,6"
                                       VerticalAlignment="Bottom" Text="{Binding Clock.Seconds}" />
                            <TextBlock Style="{StaticResource T.Base}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Text2}" Margin="4,0,0,8"
                                       VerticalAlignment="Bottom" Text="{Binding Clock.AmPm}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Text="{Binding Clock.Date}" />
                    </StackPanel>
                    </Viewbox>
                    </Grid>
                </Border>

                <!-- System -->
                <Border x:Name="SystemCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.Cog}" Width="14" Height="14" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='System', En='System'}" />
                        </StackPanel>
                        <Viewbox StretchDirection="DownOnly" Margin="0,6,0,0">
                        <UniformGrid Columns="2" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                <Grid Width="52" Height="52">
                                    <c:ProgressRing Thickness="4.5" RingBrush="{StaticResource B.Blue}" Value="{Binding System.Cpu, Converter={StaticResource Percent01}}" />
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding System.Cpu, StringFormat={}{0:0}%}" />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,5,0,0" Text="CPU" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                <Grid Width="52" Height="52">
                                    <c:ProgressRing Thickness="4.5" RingBrush="{StaticResource B.Green}" Value="{Binding System.Memory, Converter={StaticResource Percent01}}" />
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding System.Memory, StringFormat={}{0:0}%}" />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,5,0,0" Text="RAM" />
                            </StackPanel>
                        </UniformGrid>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- Messenger: latest chat messages mirrored from Windows notifications -->
                <Border x:Name="MessengerCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.Chat}" Width="14" Height="14" Foreground="{StaticResource B.Green}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Nachrichten', En='Messages'}" />
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Keine neuen Nachrichten', En='No new messages'}"
                                       Visibility="{Binding Notifications.Messages.Count, Converter={StaticResource NotVis}}" />
                            <ItemsControl ItemsSource="{Binding Notifications.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:NotificationItem}">
                                        <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Notifications.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource B.Fill2}" VerticalAlignment="Top">
                                                <Image Source="{Binding Logo}" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding TimeText}" />
                                                    <TextBlock Style="{StaticResource T.Title}" FontSize="11.5" Text="{Binding Title}" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource T.Body}" FontSize="11" Text="{Binding Body}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Claude Code sessions + quick actions -->
                <Border x:Name="ClaudeCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="22">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Claude.OpenDesktopCommand}" ToolTip="Claude Desktop">
                                    <c:Icon Data="{StaticResource Icon.AppWindow}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Claude.OpenWebCommand}" ToolTip="claude.ai/code">
                                    <c:Icon Data="{StaticResource Icon.Globe}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Sparkles}" Width="14" Height="14" Foreground="#FFD97757" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="Claude" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Keine Claude-Code-Sitzungen gefunden', En='No Claude Code sessions found'}"
                                       Visibility="{Binding Claude.Sessions.Count, Converter={StaticResource NotVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Claude.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ClaudeSession}">
                                        <Grid Margin="0,0,0,5" Background="Transparent" Cursor="Hand" ToolTip="{Binding LastPrompt}">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Claude.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Remote Control: open this session in the browser / Claude app -->
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="22" Height="22" VerticalAlignment="Top" ToolTip="Remote Control"
                                                    Visibility="{Binding HasRemote, Converter={StaticResource Vis}}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Claude.OpenRemoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <c:Icon Data="{StaticResource Icon.Globe}" Width="11" Height="11" Foreground="{StaticResource B.Text2}" />
                                            </Button>
                                            <!-- status: orange pulsing = working, amber = waiting for you, grey = idle -->
                                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="1,5,8,0" VerticalAlignment="Top" Fill="{StaticResource B.Text3}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource T.Title}" FontSize="11.5" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium">
                                                    <Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Age, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="#FFD97757" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource B.Orange}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Shortcuts (pinned apps / folders) -->
                <Border x:Name="ShortcutsCard" Style="{StaticResource Card}" Padding="10" AllowDrop="True" Drop="Shortcuts_Drop">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="22">
                            <c:Icon Data="{StaticResource Icon.AppWindow}" Width="14" Height="14" Foreground="{StaticResource B.Blue}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:L De='Schnellstart', En='Launcher'}" />
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Apps oder Ordner hierher ziehen', En='Drag apps or folders here'}"
                                       Visibility="{Binding Shortcuts.Items.Count, Converter={StaticResource NotVis}}" />
                            <ItemsControl ItemsSource="{Binding Shortcuts.Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><c:FitGrid MaxCell="46" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ShortcutItem}">
                                        <Viewbox Stretch="Uniform"><Button Style="{StaticResource Btn.Tile}" Width="44" Height="44" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.Shortcuts.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppTile}" />
                                        </Button></Viewbox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tray: shelf + clipboard -->
            <Grid x:Name="TrayGrid" Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=1}">

                <!-- Shelf -->
                <Border x:Name="ShelfCard" Style="{StaticResource Card}" Padding="10" AllowDrop="True" Drop="Shelf_Drop">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Shelf.ClearCommand}"
                                    ToolTip="{core:T Shelf.Clear}" Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}">
                                <c:Icon Data="{StaticResource Icon.Trash}" Width="12" Height="12" Foreground="{StaticResource B.Text3}" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Section}" Text="{core:T Shelf.Title}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Section}" Margin="5,0,0,0" Text="{Binding Shelf.Count}" VerticalAlignment="Center"
                                           Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Border CornerRadius="10" BorderThickness="1.2" BorderBrush="#33FFFFFF" Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource Vis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <c:Icon Data="{StaticResource Icon.DropIn}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Shelf.Empty}" />
                                    <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Shelf.EmptyHint}" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl ItemsSource="{Binding Shelf.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:ShelfItem}">
                                            <Grid Width="62" Margin="0,0,2,2" Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                                                  MouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove">
                                                <Border x:Name="Hover" CornerRadius="10" Background="Transparent" />
                                                <StackPanel Margin="3,5">
                                                    <Image Source="{Binding Icon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="10" Margin="0,4,0,0" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxHeight="26" Text="{Binding Name}" />
                                                </StackPanel>
                                                <Button x:Name="Folder" Style="{StaticResource TileButton}" Width="18" Height="18" Margin="2,2,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden" Click="ShowInFolder_Click"
                                                        ToolTip="{core:L De='Im Ordner zeigen', En='Show in folder'}">
                                                    <c:Icon Data="{StaticResource Icon.FolderOpen}" Width="10" Height="10" />
                                                </Button>
                                                <Button x:Name="Send" Style="{StaticResource TileButton}" Width="18" Height="18" Margin="2,0,0,18"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Hidden" Click="Taildrop_Click"
                                                        ToolTip="{core:L De='An Gerät senden (Taildrop)', En='Send to device (Taildrop)'}">
                                                    <c:Icon Data="{StaticResource Icon.Send}" Width="10" Height="10" />
                                                </Button>
                                                <Button x:Name="Remove" Style="{StaticResource TileButton.Danger}" Width="18" Height="18" Margin="0,2,2,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden"
                                                        Command="{Binding DataContext.Shelf.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                                                </Button>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hover" Property="Background" Value="{StaticResource B.Fill}" />
                                                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Folder" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Send" Property="Visibility" Value="{Binding DataContext.CanTaildrop, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Vis}}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Clipboard -->
                <Border x:Name="ClipCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Clipboard.ClearCommand}"
                                    ToolTip="{core:T Clip.Clear}" Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource NotVis}}">
                                <c:Icon Data="{StaticResource Icon.Trash}" Width="12" Height="12" Foreground="{StaticResource B.Text3}" />
                            </Button>
                            <TextBlock Style="{StaticResource T.Section}" Text="{core:T Clip.Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Snip}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Clip.Empty}" />
                                <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Clip.EmptyHint}" />
                            </StackPanel>
                            <ScrollViewer x:Name="ClipScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="ClipScroll_Wheel"
                                          Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl x:Name="ClipList" ItemsSource="{Binding Clipboard.Items}" ItemsPanel="{StaticResource RowPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:ClipItem}">
                                            <Grid Width="124" Margin="0,0,8,6" Background="Transparent" Cursor="Hand"
                                                  MouseLeftButtonDown="ClipItem_MouseDown" MouseMove="ClipItem_MouseMove" MouseLeftButtonUp="ClipItem_MouseUp">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="84" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- image tile -->
                                                <Border CornerRadius="10" Visibility="{Binding IsImage, Converter={StaticResource Vis}}" BorderBrush="{StaticResource B.Hairline}" BorderThickness="1">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <!-- text tile -->
                                                <Border CornerRadius="10" Background="{StaticResource B.Fill2}" Padding="9,7" Visibility="{Binding IsText, Converter={StaticResource Vis}}">
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="10.5" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                                                </Border>
                                                <!-- hover actions -->
                                                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,5" Visibility="Hidden">
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:L De='Text kopieren (Texterkennung)', En='Copy text (text recognition)'}" Click="CopyText_Click"
                                                            Visibility="{Binding IsImage, Converter={StaticResource Vis}}">
                                                        <c:Icon Data="{StaticResource Icon.ScanText}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:L De='Im Ordner zeigen', En='Show in folder'}" Click="ShowInFolder_Click"
                                                            Visibility="{Binding IsImage, Converter={StaticResource Vis}}">
                                                        <c:Icon Data="{StaticResource Icon.FolderOpen}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:T Clip.Pin}"
                                                            Command="{Binding DataContext.Clipboard.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Pin}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:T Clip.Save}"
                                                            Command="{Binding DataContext.Clipboard.SaveAsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Save}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton.Danger}" ToolTip="{core:T Clip.Delete}"
                                                            Command="{Binding DataContext.Clipboard.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Trash}" Width="11" Height="11" />
                                                    </Button>
                                                </StackPanel>
                                                <DockPanel Grid.Row="1" Margin="2,4,2,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding Age}" />
                                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Pin}" Width="10" Height="10" StrokeWidth="2.6" Margin="0,0,4,0"
                                                            Foreground="{StaticResource B.Blue}" Visibility="{Binding Pinned, Converter={StaticResource Vis}}" />
                                                    <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Text="{Binding Label}" />
                                                </DockPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Inline confirmation (e.g. "Saved to iCloud Drive") -->
            <Border x:Name="Toast" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Background="#F22C2C2E" CornerRadius="14" Padding="12,6" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{StaticResource B.Green}" StrokeWidth="2.6" />
                    <TextBlock x:Name="ToastText" Style="{StaticResource T.Base}" FontWeight="SemiBold" Margin="7,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=2}">
                <Border Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Unavailable / denied / empty states -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Unavailable}">
                            <c:Icon Data="{StaticResource Icon.BellOff}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Unavailable}" />
                            <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Notif.UnavailableHint}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Denied}">
                            <c:Icon Data="{StaticResource Icon.BellOff}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Denied}" />
                        </StackPanel>
                        <Grid Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Allowed}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Notifications.IsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Bell}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Empty}" />
                            </StackPanel>
                            <DockPanel Visibility="{Binding Notifications.IsEmpty, Converter={StaticResource NotVis}}">
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Pill}" Padding="8,2" FontSize="10.5" Background="Transparent"
                                            Foreground="{StaticResource B.Text2}" Command="{Binding Notifications.ClearAllCommand}" Content="{core:T Notif.Clear}" />
                                    <TextBlock Style="{StaticResource T.Section}" Text="{core:T Tab.Notifications}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Notifications.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type s:NotificationItem}">
                                                <Grid Margin="0,0,0,4" Background="Transparent" Cursor="Hand">
                                                    <Grid.InputBindings>
                                                        <MouseBinding Gesture="LeftClick"
                                                                      Command="{Binding DataContext.Notifications.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                                                    <Grid Margin="8,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top" Background="{StaticResource B.Fill2}">
                                                            <Image Source="{Binding Logo}" Width="22" Height="22" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding TimeText}" />
                                                                <TextBlock Style="{StaticResource T.Section}" Text="{Binding App}" />
                                                            </DockPanel>
                                                            <TextBlock Style="{StaticResource T.Title}" FontSize="12" Margin="0,2,0,0" Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" Text="{Binding Body}" />
                                                        </StackPanel>
                                                        <Button x:Name="X" Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="22" Height="22" VerticalAlignment="Top" Visibility="Hidden"
                                                                Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <c:Icon Data="{StaticResource Icon.Close}" Width="11" Height="11" Foreground="{StaticResource B.Text2}" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Fill}" />
                                                        <Setter TargetName="X" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
