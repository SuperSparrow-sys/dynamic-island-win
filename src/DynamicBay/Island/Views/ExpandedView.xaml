<UserControl x:Class="DynamicBay.Island.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DynamicBay.Controls"
             xmlns:core="clr-namespace:DynamicBay.Core"
             xmlns:s="clr-namespace:DynamicBay.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <c:BoolToVis x:Key="Vis" />
        <c:BoolToVis x:Key="NotVis" Invert="True" />
        <c:BoolToVis x:Key="VisHidden" KeepSpace="True" />
        <c:EqualsToVis x:Key="EqVis" />
        <c:EqualsToBool x:Key="EqBool" />
        <c:RatioConverter x:Key="Ratio" />
        <c:Percent01 x:Key="Percent01" />
        <c:BoolPick x:Key="PlayPauseGlyph" True="{StaticResource Glyph.Pause}" False="{StaticResource Glyph.Play}" />
        <c:BoolPick x:Key="LikeBrush" True="{StaticResource B.Pink}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="LikeGlyph" True="{StaticResource Glyph.Heart}" False="{StaticResource Icon.Heart}" />
        <c:BoolPick x:Key="OnBrush" True="{StaticResource B.Green}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="PinBrush" True="{StaticResource B.Blue}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="HideQuitTip" True="{core:L De='DynamicBay beenden', En='Quit DynamicBay'}" False="{core:L De='Ausblenden (mit Alt: Beenden)', En='Hide (with Alt: quit)'}" />
        <c:BoolPick x:Key="MicBrush" True="{StaticResource B.Orange}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="TodayBg" True="{StaticResource B.Red}" False="Transparent" />
        <c:BoolPick x:Key="TodayFg" True="{StaticResource B.Text}" False="{StaticResource B.Text2}" />
        <c:BoolPick x:Key="BatteryGlyph" True="{StaticResource Icon.BatteryCharging}" False="{StaticResource Icon.BatteryMedium}" />

        <!-- Tab label hides in the narrow vertical layout unless selected -->
        <Style x:Key="TabText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVertical}" Value="True" />
                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Fill3}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <ItemsPanelTemplate x:Key="RowPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanel"><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>

        <!-- Hover-revealed overlay buttons on tiles -->
        <!-- Dark glass circles over pictures: hover gets lighter but stays opaque, so the button never fades into the image -->
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F23A3A3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF48484A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Delete: turns red on hover -->
        <Style x:Key="TileButton.Danger" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Red}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFD93A30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <DockPanel x:Name="TopBar" Height="44" LastChildFill="False" Background="Transparent">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=0}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Sparkles}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Home}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs" Margin="2,0,0,0"
                             Visibility="{Binding Settings.ShowTrayTab, Converter={StaticResource Vis}}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=1}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Inbox}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Tray}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tab.Segment}" GroupName="tabs" Margin="2,0,0,0"
                             Visibility="{Binding Settings.ShowNotificationsTab, Converter={StaticResource Vis}}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqBool}, ConverterParameter=2}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Bell}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Style="{StaticResource TabText}" Text="{core:T Tab.Notifications}" />
                        <Border Style="{StaticResource Badge}" Visibility="{Binding Notifications.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="10" Text="{Binding Notifications.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding Battery.HasBattery, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="11.5" Foreground="{StaticResource B.Text2}"
                               Text="{Binding Battery.Percent, StringFormat={}{0} %}" VerticalAlignment="Center"
                               Visibility="{Binding IsVertical, Converter={StaticResource NotVis}}" />
                    <c:Icon Margin="5,0,0,0" Width="18" Height="18" StrokeWidth="1.8"
                            Data="{Binding Battery.IsPluggedIn, Converter={StaticResource BatteryGlyph}}"
                            Foreground="{Binding Battery.IsPluggedIn, Converter={StaticResource OnBrush}}" />
                </StackPanel>
                <!-- Microphone mute: orange while an app records, red when muted -->
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding Audio.ToggleMicMuteCommand}" ToolTip="{core:L De='Mikrofon stummschalten (Strg+Alt+M)', En='Mute microphone (Ctrl+Alt+M)'}"
                        Visibility="{Binding Settings.AudioEnabled, Converter={StaticResource Vis}}">
                    <Grid>
                        <c:Icon Data="{StaticResource Icon.Mic}" Width="15" Height="15" Foreground="{Binding Audio.MicInUse, Converter={StaticResource MicBrush}}"
                                Visibility="{Binding Audio.MicMuted, Converter={StaticResource NotVis}}" />
                        <c:Icon Data="{StaticResource Icon.MicOff}" Width="15" Height="15" Foreground="{StaticResource B.Red}"
                                Visibility="{Binding Audio.MicMuted, Converter={StaticResource Vis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding TogglePinCommand}" ToolTip="{core:T Action.Pin}">
                    <c:Icon Data="{StaticResource Icon.Pin}" Width="14" Height="14" Foreground="{Binding IsPinned, Converter={StaticResource PinBrush}}" />
                </Button>
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="{core:T Action.Settings}">
                    <c:Icon Data="{StaticResource Icon.Settings}" Width="15" Height="15" Foreground="{StaticResource B.Text2}" />
                </Button>
                <!-- Hide; with Alt held it becomes the (hidden) quit button.
                     Corner button: its centre sits 34 px from the top and from the side (12 inset + half the 44 px bar),
                     so it is centred in the panel corner like the first tab on the other side. -->
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding HideCommand}" Margin="0,0,7,0"
                        ToolTip="{Binding AltHeld, Converter={StaticResource HideQuitTip}}">
                    <Grid>
                        <c:Icon Data="{StaticResource Icon.EyeOff}" Width="15" Height="15" Foreground="{StaticResource B.Text2}"
                                Visibility="{Binding AltHeld, Converter={StaticResource NotVis}}" />
                        <c:Icon Data="{StaticResource Icon.Power}" Width="15" Height="15" Foreground="{StaticResource B.Red}" StrokeWidth="2.3"
                                Visibility="{Binding AltHeld, Converter={StaticResource Vis}}" />
                    </Grid>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ===== Pages ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">

            <!-- Home: media, calendar, timer -->
            <!-- Nook page scrolls when the chosen widgets need more room than the island has -->
            <ScrollViewer x:Name="HomeScroll" Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=0}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="HomeScroll_Wheel" SizeChanged="HomeScroll_SizeChanged">
            <Grid x:Name="HomeGrid">

                <!-- Media card -->
                <Border x:Name="MediaCard" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Nothing playing -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Media.HasSession, Converter={StaticResource NotVis}}">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource B.Fill2}" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="20" Height="20" Foreground="{StaticResource B.Text3}" />
                            </Border>
                            <TextBlock Style="{StaticResource T.Title}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="{core:T Media.Nothing}" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Media.NothingHint}" />
                        </StackPanel>

                        <!-- Now playing -->
                        <Grid Visibility="{Binding Media.HasSession, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CoverHost" Width="96" Height="96" VerticalAlignment="Top">
                                <Border CornerRadius="10" Background="{StaticResource B.Fill2}">
                                    <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="30" Height="30" Foreground="{StaticResource B.Text3}" />
                                </Border>
                                <Border CornerRadius="10" x:Name="CoverArt">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Media.Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Width="22" Height="22" CornerRadius="11" Background="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-5" Visibility="{Binding Media.IsSpotify, Converter={StaticResource Vis}}">
                                    <c:Icon Data="{StaticResource Glyph.Spotify}" Filled="True" Width="17" Height="17" Foreground="{StaticResource B.Spotify}" />
                                </Border>
                                <!-- Apple Music: generic music note on the service's pink-red gradient (no Apple logo) -->
                                <Border Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-5" BorderBrush="Black" BorderThickness="1.5" Visibility="{Binding Media.IsAppleMusic, Converter={StaticResource Vis}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFC5C7D" Offset="0" />
                                            <GradientStop Color="#FFFA233B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="12" Height="12" Foreground="White" />
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <c:Waveform DockPanel.Dock="Right" Width="18" Height="13" Margin="8,2,0,0" VerticalAlignment="Top"
                                                IsPlaying="{Binding Media.IsPlaying}" BarBrush="{Binding Media.AccentBrush}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource T.Headline}" Text="{Binding Media.Title}" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,1,0,0" FontSize="12.5" Text="{Binding Media.Artist}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Timeline: click or drag to seek; on hover the bar thickens and shows its knob -->
                                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                    <Grid x:Name="Timeline" Height="16" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp">
                                        <Border x:Name="TimelineTrack" Height="4" CornerRadius="3" Background="{StaticResource B.Fill3}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border x:Name="TimelineFill" Height="4" CornerRadius="3" Background="{StaticResource B.Text}" VerticalAlignment="Center">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource Ratio}">
                                                        <Binding Path="Media.PositionSeconds" />
                                                        <Binding Path="Media.DurationSeconds" />
                                                        <Binding Path="ActualWidth" ElementName="Timeline" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                            <Border x:Name="TimelineKnob" Width="12" Height="12" CornerRadius="6" Margin="-6,0,0,0" Background="{StaticResource B.Text}"
                                                    VerticalAlignment="Center" Opacity="0">
                                                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                                            </Border>
                                        </StackPanel>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TimelineKnob" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineTrack" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineFill" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TimelineKnob" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineTrack" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="TimelineFill" Storyboard.TargetProperty="Height" To="4" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Numeric}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource B.Text3}" Text="{Binding Media.RemainingText}" />
                                        <TextBlock Style="{StaticResource T.Numeric}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource B.Text3}" Text="{Binding Media.PositionText}" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- Transport -->
                                <!-- Like | previous, play, next | devices: own columns, so nothing overlaps on a narrow card -->
                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource Btn.Icon}" Command="{Binding Spotify.ToggleLikeCommand}"
                                            Visibility="{Binding Spotify.IsConnected, Converter={StaticResource Vis}}" ToolTip="{core:T Media.Like}">
                                        <c:Icon Width="16" Height="16" Data="{Binding Spotify.IsLiked, Converter={StaticResource LikeGlyph}}"
                                                Filled="{Binding Spotify.IsLiked}" Foreground="{Binding Spotify.IsLiked, Converter={StaticResource LikeBrush}}" />
                                    </Button>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Media}" Command="{Binding Media.PreviousCommand}">
                                            <c:Icon Data="{StaticResource Glyph.Previous}" Filled="True" Width="20" Height="20" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Media}" Width="42" Height="42" Margin="6,0" Command="{Binding Media.PlayPauseCommand}">
                                            <c:Icon Data="{Binding Media.IsPlaying, Converter={StaticResource PlayPauseGlyph}}" Filled="True" Width="26" Height="26" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Media}" Command="{Binding Media.NextCommand}">
                                            <c:Icon Data="{StaticResource Glyph.Next}" Filled="True" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource Btn.Icon}" Click="Devices_Click"
                                            Visibility="{Binding Spotify.IsConnected, Converter={StaticResource Vis}}" ToolTip="{core:T Media.Devices}">
                                        <c:Icon Data="{StaticResource Icon.Devices}" Width="16" Height="16" Foreground="{StaticResource B.Text2}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Spotify device picker overlay -->
                        <Border x:Name="DevicesOverlay" Visibility="Collapsed" Background="#F2161618" CornerRadius="16" Margin="-6">
                            <DockPanel Margin="12,8">
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Click="DevicesClose_Click">
                                        <c:Icon Data="{StaticResource Icon.Close}" Width="13" Height="13" Foreground="{StaticResource B.Text2}" />
                                    </Button>
                                    <TextBlock Style="{StaticResource T.Section}" Text="{core:T Media.Devices}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Spotify.Devices}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:SpotifyDevice}">
                                            <Button Style="{StaticResource Btn.Pill}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="8,5"
                                                    Command="{Binding DataContext.Spotify.TransferToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:Icon Data="{StaticResource Icon.Speaker}" Width="14" Height="14" Foreground="{Binding IsActive, Converter={StaticResource OnBrush}}" />
                                                    <TextBlock Style="{StaticResource T.Base}" Margin="8,0,0,0" Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Calendar card -->
                <Border x:Name="CalendarCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource T.Title}" Foreground="{StaticResource B.Red}" Text="{Binding Calendar.MonthText}" />
                        </DockPanel>
                        <!-- Fixed-width day cells scaled as a whole, so the "today" circle stays round in narrow cards -->
                        <Viewbox DockPanel.Dock="Top" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="-2,6,-2,0">
                        <ItemsControl ItemsSource="{Binding Calendar.Week}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type s:DayCell}">
                                    <!-- Tap a day to see its events; the chosen day gets a ring, today stays red; a dot marks days with events -->
                                    <StackPanel HorizontalAlignment="Center" Width="23" Background="Transparent" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.Calendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </StackPanel.InputBindings>
                                        <TextBlock Style="{StaticResource T.Section}" FontSize="8.5" HorizontalAlignment="Center" Text="{Binding Weekday}" />
                                        <Grid Width="20" Height="20" Margin="0,3,0,0">
                                            <Border CornerRadius="10" Background="{Binding IsToday, Converter={StaticResource TodayBg}}" />
                                            <Border CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource B.Text}"
                                                    Visibility="{Binding ShowRing, Converter={StaticResource Vis}}" />
                                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding IsToday, Converter={StaticResource TodayFg}}" Text="{Binding Day}" />
                                        </Grid>
                                        <Border Width="3" Height="3" CornerRadius="1.5" Margin="0,2,0,0" Background="{StaticResource B.Text3}"
                                                Visibility="{Binding HasEvents, Converter={StaticResource VisHidden}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Viewbox>

                        <Grid Margin="0,8,0,0">
                            <!-- Events of the chosen day: all-day ones on top, then the timed ones (scrolls when there are many) -->
                            <DockPanel Visibility="{Binding Calendar.DayIsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Calendar.DayAllDay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:CalendarEvent}">
                                            <Border CornerRadius="6" Background="{Binding SoftBrush}" Padding="7,3" Margin="0,0,0,4">
                                                <TextBlock Style="{StaticResource T.Title}" FontSize="11" Foreground="{StaticResource B.Text}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding Calendar.DayEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type s:CalendarEvent}">
                                                <DockPanel Margin="0,0,0,7">
                                                    <Border Width="3" CornerRadius="1.5" Background="{Binding Brush}" Margin="0,1,8,1" />
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource T.Title}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Margin="0,1,0,0" Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding Calendar.DayIsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Calendar}" Width="16" Height="16" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           Text="{Binding Calendar.DayEmptyText}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Timer card -->
                <Border x:Name="TimerCard" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Idle: presets -->
                        <DockPanel Visibility="{Binding Timer.IsActive, Converter={StaticResource NotVis}}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Timer}" Width="14" Height="14" Foreground="{StaticResource B.Orange}" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" Text="{core:T Timer.Title}" />
                            </StackPanel>
                            <UniformGrid Columns="2" Rows="2" Margin="0,10,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Chip}" Margin="0,0,3,3" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>1</sys:Double></Button.CommandParameter>1 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="3,0,0,3" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>5</sys:Double></Button.CommandParameter>5 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="0,3,3,0" Padding="0,7" Height="32" Command="{Binding Timer.StartMinutesCommand}">
                                    <Button.CommandParameter><sys:Double>10</sys:Double></Button.CommandParameter>10 min</Button>
                                <Button Style="{StaticResource Btn.Chip}" Margin="3,3,0,0" Padding="0,7" Height="32" Background="#33FF9F0A" Foreground="{StaticResource B.Orange}"
                                        Command="{Binding Timer.StartFocusCommand}" Content="{core:T Timer.Pomodoro}" />
                            </UniformGrid>
                        </DockPanel>

                        <!-- Running -->
                        <Grid Visibility="{Binding Timer.IsActive, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Width="78" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:ProgressRing Thickness="5" Value="{Binding Timer.Progress}" RingBrush="{StaticResource B.Orange}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="17" HorizontalAlignment="Center" Text="{Binding Timer.RemainingText}" />
                                    <TextBlock Style="{StaticResource T.Section}" FontSize="9.5" HorizontalAlignment="Center" Text="{Binding Timer.ModeText}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Background="{StaticResource B.Fill2}" Command="{Binding Timer.StopCommand}" ToolTip="{core:T Timer.Reset}">
                                    <c:Icon Data="{StaticResource Icon.Close}" Width="13" Height="13" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="8,0,0,0" Background="#33FF9F0A" Command="{Binding Timer.TogglePauseCommand}">
                                    <c:Icon Data="{Binding Timer.IsRunning, Converter={StaticResource PlayPauseGlyph}}" Filled="True" Width="13" Height="13" Foreground="{StaticResource B.Orange}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Optional widgets (shown when enabled in settings; laid out in code) -->
            <Grid x:Name="ExtraCards" Visibility="Collapsed">
                <!-- Clock -->
                <Border x:Name="ClockCard" Style="{StaticResource Card}" Padding="10">
                    <!-- Scales down in narrow slots instead of clipping the digits -->
                    <Viewbox StretchDirection="DownOnly">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Foreground="{StaticResource B.Orange}" Text="{Binding Clock.Weekday}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="38" FontWeight="Bold" Text="{Binding Clock.Time}" />
                            <TextBlock Style="{StaticResource T.Numeric}" FontSize="18" Foreground="{StaticResource B.Text2}" Margin="1,0,0,6"
                                       VerticalAlignment="Bottom" Text="{Binding Clock.Seconds}" />
                            <TextBlock Style="{StaticResource T.Base}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Text2}" Margin="4,0,0,8"
                                       VerticalAlignment="Bottom" Text="{Binding Clock.AmPm}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Text="{Binding Clock.Date}" />
                    </StackPanel>
                    </Viewbox>
                </Border>

                <!-- System -->
                <Border x:Name="SystemCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Title}" Text="{core:L De='System', En='System'}" />
                        <Viewbox StretchDirection="DownOnly" Margin="0,6,0,0">
                        <UniformGrid Columns="2" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                <Grid Width="52" Height="52">
                                    <c:ProgressRing Thickness="4.5" RingBrush="{StaticResource B.Blue}" Value="{Binding System.Cpu, Converter={StaticResource Percent01}}" />
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding System.Cpu, StringFormat={}{0:0}%}" />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,5,0,0" Text="CPU" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                <Grid Width="52" Height="52">
                                    <c:ProgressRing Thickness="4.5" RingBrush="{StaticResource B.Green}" Value="{Binding System.Memory, Converter={StaticResource Percent01}}" />
                                    <TextBlock Style="{StaticResource T.Numeric}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding System.Memory, StringFormat={}{0:0}%}" />
                                </Grid>
                                <TextBlock Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,5,0,0" Text="RAM" />
                            </StackPanel>
                        </UniformGrid>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- Messenger: latest chat messages mirrored from Windows notifications -->
                <Border x:Name="MessengerCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Title}" Text="{core:L De='Nachrichten', En='Messages'}" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Keine neuen Nachrichten', En='No new messages'}"
                                       Visibility="{Binding Notifications.Messages.Count, Converter={StaticResource NotVis}}" />
                            <ItemsControl ItemsSource="{Binding Notifications.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:NotificationItem}">
                                        <Grid Margin="0,0,0,6" Background="Transparent" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Notifications.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource B.Fill2}" VerticalAlignment="Top">
                                                <Image Source="{Binding Logo}" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding TimeText}" />
                                                    <TextBlock Style="{StaticResource T.Title}" FontSize="11.5" Text="{Binding Title}" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource T.Body}" FontSize="11" Text="{Binding Body}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Claude Code sessions + quick actions -->
                <Border x:Name="ClaudeCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Claude.OpenDesktopCommand}" ToolTip="Claude Desktop">
                                    <c:Icon Data="{StaticResource Icon.AppWindow}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Claude.OpenWebCommand}" ToolTip="claude.ai/code">
                                    <c:Icon Data="{StaticResource Icon.Globe}" Width="12" Height="12" Foreground="{StaticResource B.Text2}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Sparkles}" Width="14" Height="14" Foreground="#FFD97757" />
                                <TextBlock Style="{StaticResource T.Title}" Margin="6,0,0,0" Text="Claude" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Keine Claude-Code-Sitzungen gefunden', En='No Claude Code sessions found'}"
                                       Visibility="{Binding Claude.Sessions.Count, Converter={StaticResource NotVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Claude.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ClaudeSession}">
                                        <Grid Margin="0,0,0,5" Background="Transparent" Cursor="Hand" ToolTip="{Binding LastPrompt}">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Claude.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Remote Control: open this session in the browser / Claude app -->
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="22" Height="22" VerticalAlignment="Top" ToolTip="Remote Control"
                                                    Visibility="{Binding HasRemote, Converter={StaticResource Vis}}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Claude.OpenRemoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <c:Icon Data="{StaticResource Icon.Globe}" Width="11" Height="11" Foreground="{StaticResource B.Text2}" />
                                            </Button>
                                            <!-- status: orange pulsing = working, amber = waiting for you, grey = idle -->
                                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="1,5,8,0" VerticalAlignment="Top" Fill="{StaticResource B.Text3}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource T.Title}" FontSize="11.5" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium">
                                                    <Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Age, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="#FFD97757" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource B.Orange}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Shortcuts (pinned apps / folders) -->
                <Border x:Name="ShortcutsCard" Style="{StaticResource Card}" Padding="10" AllowDrop="True" Drop="Shortcuts_Drop">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Title}" Text="{core:L De='Schnellstart', En='Launcher'}" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{core:L De='Apps oder Ordner hierher ziehen', En='Drag apps or folders here'}"
                                       Visibility="{Binding Shortcuts.Items.Count, Converter={StaticResource NotVis}}" />
                            <ItemsControl ItemsSource="{Binding Shortcuts.Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><c:FitGrid MaxCell="46" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ShortcutItem}">
                                        <Viewbox Stretch="Uniform"><Button Style="{StaticResource Btn.Tile}" Width="44" Height="44" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.Shortcuts.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppTile}" />
                                        </Button></Viewbox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tray: shelf + clipboard -->
            <Grid x:Name="TrayGrid" Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=1}">

                <!-- Shelf -->
                <Border x:Name="ShelfCard" Style="{StaticResource Card}" Padding="10" AllowDrop="True" Drop="Shelf_Drop">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Shelf.ClearCommand}"
                                    ToolTip="{core:T Shelf.Clear}" Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}">
                                <c:Icon Data="{StaticResource Icon.Trash}" Width="12" Height="12" Foreground="{StaticResource B.Text3}" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Section}" Text="{core:T Shelf.Title}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Section}" Margin="5,0,0,0" Text="{Binding Shelf.Count}" VerticalAlignment="Center"
                                           Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Border CornerRadius="10" BorderThickness="1.2" BorderBrush="#33FFFFFF" Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource Vis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <c:Icon Data="{StaticResource Icon.DropIn}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Shelf.Empty}" />
                                    <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Shelf.EmptyHint}" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl ItemsSource="{Binding Shelf.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:ShelfItem}">
                                            <Grid Width="62" Margin="0,0,2,2" Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                                                  MouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove">
                                                <Border x:Name="Hover" CornerRadius="10" Background="Transparent" />
                                                <StackPanel Margin="3,5">
                                                    <Image Source="{Binding Icon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="10" Margin="0,4,0,0" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxHeight="26" Text="{Binding Name}" />
                                                </StackPanel>
                                                <Button x:Name="Cloud" Style="{StaticResource TileButton}" Width="18" Height="18" Margin="2,2,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden" Click="CloudSave_Click"
                                                        ToolTip="{core:T Cloud.SaveTo}">
                                                    <c:Icon Data="{StaticResource Icon.CloudUpload}" Width="10" Height="10" />
                                                </Button>
                                                <Button x:Name="Remove" Style="{StaticResource TileButton.Danger}" Width="18" Height="18" Margin="0,2,2,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden"
                                                        Command="{Binding DataContext.Shelf.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                                                </Button>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hover" Property="Background" Value="{StaticResource B.Fill}" />
                                                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Cloud" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Clipboard -->
                <Border x:Name="ClipCard" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" Command="{Binding Clipboard.ClearCommand}"
                                    ToolTip="{core:T Clip.Clear}" Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource NotVis}}">
                                <c:Icon Data="{StaticResource Icon.Trash}" Width="12" Height="12" Foreground="{StaticResource B.Text3}" />
                            </Button>
                            <TextBlock Style="{StaticResource T.Section}" Text="{core:T Clip.Title}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Snip}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Clip.Empty}" />
                                <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Clip.EmptyHint}" />
                            </StackPanel>
                            <ScrollViewer x:Name="ClipScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="ClipScroll_Wheel"
                                          Visibility="{Binding Clipboard.IsEmpty, Converter={StaticResource NotVis}}">
                                <ItemsControl x:Name="ClipList" ItemsSource="{Binding Clipboard.Items}" ItemsPanel="{StaticResource RowPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type s:ClipItem}">
                                            <Grid Width="124" Margin="0,0,8,6" Background="Transparent" Cursor="Hand"
                                                  MouseLeftButtonDown="ClipItem_MouseDown" MouseMove="ClipItem_MouseMove" MouseLeftButtonUp="ClipItem_MouseUp">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="84" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- image tile -->
                                                <Border CornerRadius="10" Visibility="{Binding IsImage, Converter={StaticResource Vis}}" BorderBrush="{StaticResource B.Hairline}" BorderThickness="1">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <!-- text tile -->
                                                <Border CornerRadius="10" Background="{StaticResource B.Fill2}" Padding="9,7" Visibility="{Binding IsText, Converter={StaticResource Vis}}">
                                                    <TextBlock Style="{StaticResource T.Base}" FontSize="10.5" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                                                </Border>
                                                <!-- hover actions -->
                                                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,5" Visibility="Hidden">
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:T Cloud.SaveTo}" Click="CloudSave_Click">
                                                        <c:Icon Data="{StaticResource Icon.CloudUpload}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:T Clip.Pin}"
                                                            Command="{Binding DataContext.Clipboard.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Pin}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton}" ToolTip="{core:T Clip.Save}"
                                                            Command="{Binding DataContext.Clipboard.SaveAsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Save}" Width="11" Height="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource TileButton.Danger}" ToolTip="{core:T Clip.Delete}"
                                                            Command="{Binding DataContext.Clipboard.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:Icon Data="{StaticResource Icon.Trash}" Width="11" Height="11" />
                                                    </Button>
                                                </StackPanel>
                                                <DockPanel Grid.Row="1" Margin="2,4,2,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding Age}" />
                                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Pin}" Width="10" Height="10" StrokeWidth="2.6" Margin="0,0,4,0"
                                                            Foreground="{StaticResource B.Blue}" Visibility="{Binding Pinned, Converter={StaticResource Vis}}" />
                                                    <TextBlock Style="{StaticResource T.Caption}" FontSize="10.5" Text="{Binding Label}" />
                                                </DockPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Inline confirmation (e.g. "Saved to iCloud Drive") -->
            <Border x:Name="Toast" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Background="#F22C2C2E" CornerRadius="14" Padding="12,6" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{StaticResource B.Green}" StrokeWidth="2.6" />
                    <TextBlock x:Name="ToastText" Style="{StaticResource T.Base}" FontWeight="SemiBold" Margin="7,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource EqVis}, ConverterParameter=2}">
                <Border Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <!-- Unavailable / denied / empty states -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Unavailable}">
                            <c:Icon Data="{StaticResource Icon.BellOff}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Unavailable}" />
                            <TextBlock Style="{StaticResource T.Section}" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" Text="{core:T Notif.UnavailableHint}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Denied}">
                            <c:Icon Data="{StaticResource Icon.BellOff}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Denied}" />
                        </StackPanel>
                        <Grid Visibility="{Binding Notifications.Access, Converter={StaticResource EqVis}, ConverterParameter=Allowed}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Notifications.IsEmpty, Converter={StaticResource Vis}}">
                                <c:Icon Data="{StaticResource Icon.Bell}" Width="20" Height="20" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{core:T Notif.Empty}" />
                            </StackPanel>
                            <DockPanel Visibility="{Binding Notifications.IsEmpty, Converter={StaticResource NotVis}}">
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Pill}" Padding="8,2" FontSize="10.5" Background="Transparent"
                                            Foreground="{StaticResource B.Text2}" Command="{Binding Notifications.ClearAllCommand}" Content="{core:T Notif.Clear}" />
                                    <TextBlock Style="{StaticResource T.Section}" Text="{core:T Tab.Notifications}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Notifications.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type s:NotificationItem}">
                                                <Grid Margin="0,0,0,4" Background="Transparent" Cursor="Hand">
                                                    <Grid.InputBindings>
                                                        <MouseBinding Gesture="LeftClick"
                                                                      Command="{Binding DataContext.Notifications.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                                                    <Grid Margin="8,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top" Background="{StaticResource B.Fill2}">
                                                            <Image Source="{Binding Logo}" Width="22" Height="22" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Section}" FontWeight="Medium" Text="{Binding TimeText}" />
                                                                <TextBlock Style="{StaticResource T.Section}" Text="{Binding App}" />
                                                            </DockPanel>
                                                            <TextBlock Style="{StaticResource T.Title}" FontSize="12" Margin="0,2,0,0" Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" Text="{Binding Body}" />
                                                        </StackPanel>
                                                        <Button x:Name="X" Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="22" Height="22" VerticalAlignment="Top" Visibility="Hidden"
                                                                Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <c:Icon Data="{StaticResource Icon.Close}" Width="11" Height="11" Foreground="{StaticResource B.Text2}" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Fill}" />
                                                        <Setter TargetName="X" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
