<UserControl x:Class="DynamicBay.Island.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DynamicBay.Controls"
             xmlns:core="clr-namespace:DynamicBay.Core"
             xmlns:sc="clr-namespace:DynamicBay.Services.Scripting">
    <UserControl.Resources>
        <c:BoolToVis x:Key="Vis" />
        <c:BoolToVis x:Key="NotVis" Invert="True" />
    </UserControl.Resources>

    <!-- Live activities side by side in one island -->
    <c:SegmentStack x:Name="Stack" Spacing="22" Margin="14,0">

        <!-- Status symbols in front: microphone in use (orange) / muted (red), camera in use (green), sound off -->
        <Grid Visibility="{Binding ShowStatus, Converter={StaticResource Vis}}">
            <StackPanel x:Name="StatusH" Orientation="Horizontal" Margin="0,0,-6,0">
                <Grid Visibility="{Binding ShowMic, Converter={StaticResource Vis}}" Margin="0,0,6,0" ToolTip="{Binding Audio.MicApp}">
                    <c:Icon Data="{StaticResource Icon.Mic}" Width="13" Height="13" StrokeWidth="2.2" Foreground="{StaticResource B.Orange}"
                            Visibility="{Binding Audio.MicMuted, Converter={StaticResource NotVis}}" />
                    <c:Icon Data="{StaticResource Icon.MicOff}" Width="13" Height="13" StrokeWidth="2.2" Foreground="{StaticResource B.Red}"
                            Visibility="{Binding Audio.MicMuted, Converter={StaticResource Vis}}" />
                </Grid>
                <c:Icon Data="{StaticResource Icon.Video}" Width="13" Height="13" StrokeWidth="2.2" Foreground="{StaticResource B.Green}" Margin="0,0,6,0"
                        Visibility="{Binding ShowCamera, Converter={StaticResource Vis}}" />
                <c:Icon Data="{StaticResource Icon.VolumeOff}" Width="14" Height="14" StrokeWidth="2.2" Foreground="{StaticResource B.Text2}" Margin="0,0,6,0"
                        Visibility="{Binding ShowMuted, Converter={StaticResource Vis}}" />
            </StackPanel>
            <StackPanel x:Name="StatusV" Visibility="Collapsed">
                <c:Icon Data="{StaticResource Icon.Mic}" Width="13" Height="13" StrokeWidth="2.2" Foreground="{StaticResource B.Orange}" Margin="0,0,0,6"
                        Visibility="{Binding ShowMic, Converter={StaticResource Vis}}" />
                <c:Icon Data="{StaticResource Icon.VolumeOff}" Width="14" Height="14" StrokeWidth="2.2" Foreground="{StaticResource B.Text2}" Margin="0,0,0,6"
                        Visibility="{Binding ShowMuted, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>

        <!-- Music -->
        <Grid x:Name="MediaSeg" Visibility="{Binding ShowMedia, Converter={StaticResource Vis}}">
            <StackPanel x:Name="MediaH" Orientation="Horizontal">
                <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="13" Height="13" Foreground="{Binding Media.AccentBrush}" />
                <c:Waveform Margin="9,0,0,0" Width="17" Height="11" IsPlaying="{Binding Media.IsPlaying}" BarBrush="{Binding Media.AccentBrush}" />
            </StackPanel>
            <StackPanel x:Name="MediaV" Orientation="Vertical" Visibility="Collapsed">
                <c:Icon Data="{StaticResource Glyph.Music}" Filled="True" Width="13" Height="13" Foreground="{Binding Media.AccentBrush}" />
                <c:Waveform Margin="0,8,0,0" Width="11" Height="17" Vertical="True" IsPlaying="{Binding Media.IsPlaying}" BarBrush="{Binding Media.AccentBrush}" />
            </StackPanel>
        </Grid>

        <!-- Timer -->
        <Grid Visibility="{Binding ShowTimer, Converter={StaticResource Vis}}">
            <StackPanel x:Name="TimerH" Orientation="Horizontal">
                <c:ProgressRing Width="12" Height="12" Thickness="2.2" Value="{Binding Timer.Progress}" RingBrush="{StaticResource B.Orange}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource T.Numeric}" FontSize="12" Foreground="{StaticResource B.Orange}"
                           Text="{Binding Timer.RemainingText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="TimerV" Visibility="Collapsed">
                <c:ProgressRing Width="12" Height="12" Thickness="2.2" Value="{Binding Timer.Progress}" RingBrush="{StaticResource B.Orange}" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource T.Numeric}" FontSize="9.5" Foreground="{StaticResource B.Orange}"
                           Text="{Binding Timer.RemainingText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Calendar soon -->
        <Grid Visibility="{Binding ShowCalendar, Converter={StaticResource Vis}}">
            <StackPanel x:Name="CalH" Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Calendar}" Width="12" Height="12" StrokeWidth="2.4" Foreground="{StaticResource B.Red}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource T.Numeric}" FontSize="12" Text="{Binding Calendar.SoonText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="CalV" Visibility="Collapsed">
                <c:Icon Data="{StaticResource Icon.Calendar}" Width="12" Height="12" StrokeWidth="2.4" Foreground="{StaticResource B.Red}" />
            </StackPanel>
        </Grid>

        <!-- Claude Code agent working / waiting -->
        <Grid Visibility="{Binding ShowClaude, Converter={StaticResource Vis}}">
            <StackPanel x:Name="ClaudeH" Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Sparkles}" Width="13" Height="13" StrokeWidth="2.2" Foreground="#FFD97757" RenderTransformOrigin="0.5,0.5">
                    <c:Icon.RenderTransform><RotateTransform /></c:Icon.RenderTransform>
                    <c:Loop.Storyboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:4" />
                        </Storyboard>
                    </c:Loop.Storyboard>
                </c:Icon>
                <TextBlock Margin="7,0,0,0" Style="{StaticResource T.Title}" FontSize="12" Foreground="#FFE8A98F" MaxWidth="120"
                           Text="{Binding Claude.WorkingText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="ClaudeV" Visibility="Collapsed">
                <c:Icon Data="{StaticResource Icon.Sparkles}" Width="13" Height="13" StrokeWidth="2.2" Foreground="#FFD97757" />
            </StackPanel>
        </Grid>

        <!-- Clock -->
        <Grid Visibility="{Binding ShowClock, Converter={StaticResource Vis}}">
            <StackPanel x:Name="ClockH" Orientation="Horizontal">
                <TextBlock Style="{StaticResource T.Numeric}" FontSize="12.5" Text="{Binding Clock.Time}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource T.Numeric}" FontSize="12.5" Foreground="{StaticResource B.Text2}" Text="{Binding Clock.Seconds}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource T.Base}" FontSize="9.5" FontWeight="SemiBold" Margin="3,1,0,0" Foreground="{StaticResource B.Text2}" Text="{Binding Clock.AmPm}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="ClockV" Visibility="Collapsed">
                <TextBlock Style="{StaticResource T.Numeric}" FontSize="10" HorizontalAlignment="Center" Text="{Binding Clock.Time}" />
            </StackPanel>
        </Grid>

        <!-- Own script widgets: their one-line "Mini" version -->
        <ItemsControl x:Name="ScriptsSeg" Visibility="{Binding ShowScripts, Converter={StaticResource Vis}}" ItemsSource="{Binding Scripts.CompactIds}"
                      VerticalAlignment="Center" HorizontalAlignment="Center" Tag="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <sc:ScriptWidgetView ScriptId="{Binding}" Family="accessoryInline" Margin="5" MaxWidth="160" VerticalAlignment="Center"
                                         Vertical="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Battery low -->
        <Grid Visibility="{Binding ShowBatteryLow, Converter={StaticResource Vis}}">
            <StackPanel x:Name="BatH" Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.BatteryLow}" Width="15" Height="15" StrokeWidth="2.2" Foreground="{StaticResource B.Red}" />
                <TextBlock Margin="6,0,0,0" Style="{StaticResource T.Numeric}" FontSize="12" Foreground="{StaticResource B.Red}"
                           Text="{Binding Battery.Percent, StringFormat={}{0} %}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="BatV" Visibility="Collapsed">
                <c:Icon Data="{StaticResource Icon.BatteryLow}" Width="14" Height="14" StrokeWidth="2.2" Foreground="{StaticResource B.Red}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource T.Numeric}" FontSize="9.5" Foreground="{StaticResource B.Red}"
                           Text="{Binding Battery.Percent}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </c:SegmentStack>
</UserControl>
