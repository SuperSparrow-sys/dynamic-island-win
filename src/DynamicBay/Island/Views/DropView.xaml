<UserControl x:Class="DynamicBay.Island.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DynamicBay.Controls"
             xmlns:core="clr-namespace:DynamicBay.Core"
             Width="380" Height="132">
    <Grid Margin="12">
        <!-- Dashed drop target with a slow marching border -->
        <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="1.5" StrokeDashArray="5 4" Stroke="#66FFFFFF" Fill="#0DFFFFFF">
            <c:Loop.Storyboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-18" Duration="0:0:1.2" />
                </Storyboard>
            </c:Loop.Storyboard>
        </Rectangle>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" Background="#260A84FF">
                <c:Icon x:Name="DropIcon" Data="{StaticResource Icon.DropIn}" Width="22" Height="22" Foreground="{StaticResource B.Blue}"
                        RenderTransformOrigin="0.5,0.5">
                    <c:Icon.RenderTransform><TranslateTransform /></c:Icon.RenderTransform>
                    <c:Loop.Storyboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="-2" To="2" Duration="0:0:0.7">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </c:Loop.Storyboard>
                </c:Icon>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource T.Headline}" Text="{core:T Drop.Title}" />
                <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0" Text="{core:T Drop.Subtitle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
